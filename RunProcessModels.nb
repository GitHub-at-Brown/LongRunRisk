            RowBox[{
             RowBox[{"den", "==", "0"}], " ", "&&", " ", "ass"}], "]"}]}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"nonZeroDen", ",", 
          RowBox[{"num", "==", "0"}], ",", "expr"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
