         ";", "\[IndentingNewLine]", 
         RowBox[{"tr", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"1", "-", "gamma"}], 
                  RowBox[{"1", "-", 
                   FractionBox["1", "psi"]}]], "==", "theta"}], ",", "#"}], 
               "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"psi", ",", "gamma", ",", "theta"}], "}"}]}], ",", 
            "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sysSimp", "=", 
          RowBox[{"tryTransforms", "[", 
           RowBox[{"sysSimp", ",", "tr", ",", "assume"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "sysSimp", "}"}]}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
