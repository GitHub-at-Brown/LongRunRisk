          RowBox[{"Listable", ",", "HoldRest"}], "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cancelDen", "[", 
       RowBox[{"expr_", ",", 
        RowBox[{"ass_", ":", "True"}]}], "]"}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
