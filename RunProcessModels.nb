        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", "exprTogether", "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"nonZeroDen", "=", 
         RowBox[{"TrueQ", "@", 
          RowBox[{"Not", "@", 
