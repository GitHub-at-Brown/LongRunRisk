Cell["\<\
The OnlyQuadTerms option allows solving only for variables that appear with \
degree \[GreaterEqual] 2 in at least one equation, treating other variables \
as parameters.\
\>", "ExampleText",
 CellID->461234567,ExpressionUUID->"c3d4e5f6-a7b8-c9d0-e1f2-a3b4c5d6e7f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "+",
      RowBox[{"a", " ", "x"}], "+", "b"}], "\[Equal]", "0"}], ",",
    RowBox[{
     RowBox[{"y", "+",
      RowBox[{"2", " ", "x"}]}], "\[Equal]", "c"}], ",",
    RowBox[{"z", "\[Equal]",
     RowBox[{
      RowBox[{"3", " ", "a"}], "+", "b"}]}]}], "}"}]}], "\n",
 RowBox[{"vars", "=",
  RowBox[{"{",
   RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "\n",
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{"eqns", ",", "vars", ",",
    RowBox[{"OnlyQuadTerms", "\[Rule]", "True"}]}], "]"}]}], "\n",
 RowBox[{"result", "[", "\"\<Solution\>\"", "]"}], "\n",
 RowBox[{"result", "[", "\"\<DeferredVariables\>\"", "]"}], "\n",
 RowBox[{"result", "[", "\"\<DeferredEquations\>\"", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->462345678,ExpressionUUID->"d4e5f6a7-b8c9-d0e1-f2a3-b4c5d6e7f8a9"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"x", "\[Rule]",
   RowBox[{
    FractionBox[
     RowBox[{"-", "a"}], "2"], "+",
    FractionBox[
     RowBox[{
      RowBox[{"signA", "[", "1", "]"}], " ",
      SqrtBox[
       RowBox[{
        SuperscriptBox["a", "2"], "-",
        RowBox[{"4", " ", "b"}]}]]}], "2"]}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->463456789,ExpressionUUID->"e5f6a7b8-c9d0-e1f2-a3b4-c5d6e7f8a9b0"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"y", ",", "z"}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->464567890,ExpressionUUID->"f6a7b8c9-d0e1-f2a3-b4c5-d6e7f8a9b0c1"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{
    RowBox[{"y", "+",
     RowBox[{"2", " ", "x"}]}], "\[Equal]", "c"}], ",",
   RowBox[{"z", "\[Equal]",
    RowBox[{
     RowBox[{"3", " ", "a"}], "+", "b"}]}]}], "}"}]], "Output",
 CellLabel->"Out[6]=",
 CellID->465678901,ExpressionUUID->"a7b8c9d0-e1f2-a3b4-c5d6-e7f8a9b0c1d2"]

}, Open  ]],

Cell[TextData[{
 "Only ",
 Cell[BoxData["x"], "InlineFormula",ExpressionUUID->
  "b8c9d0e1-f2a3-b4c5-d6e7-e8f9a0b1c2d3"],
 " appears quadratically, so it is solved. Variables ",
 Cell[BoxData["y"], "InlineFormula",ExpressionUUID->
  "c9d0e1f2-a3b4-c5d6-e7f8-a9b0c1d2e3f4"],
 " and ",
 Cell[BoxData["z"], "InlineFormula",ExpressionUUID->
