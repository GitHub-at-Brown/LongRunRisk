Cell["\<\
The Validation option controls whether solutions are automatically verified by \
substitution back into the original equations.\
\>", "ExampleText",
 CellID->425567890,ExpressionUUID->"c3d4e5f6-a7b8-c9d0-e1f2-a3b4c5d6e7f8"],

