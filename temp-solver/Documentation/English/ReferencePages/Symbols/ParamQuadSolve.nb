}, Open  ]],

Cell["\<\
With OnlyQuadTerms->False (default), all variables are solved. With \
OnlyQuadTerms->True, only quadratic variable A is solved, and B is deferred.\
\>", "ExampleText",
 CellID->467189016,ExpressionUUID->"e5f6a7b8-c9d0-e1f2-a3b4-c5d6e7f8a9b0"]

}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Assumptions", "ExampleSubsection",ExpressionUUID->
   "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->467890123,ExpressionUUID->"b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e"],

Cell["\<\
The solver uses default assumptions for common parameters in economic models. \
You can override these with custom assumptions.\
\>", "ExampleText",
 CellID->468901234,ExpressionUUID->"c3d4e5f6-a7b8-c9d0-e1f2-a3b4c5d6e7f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "2"], "-",
      RowBox[{"3", " ", "A"}], "+", "delta"}], "\[Equal]", "0"}], ",",
    RowBox[{
     RowBox[{"B", "-",
      RowBox[{"psi", " ", "A"}]}], "\[Equal]", "0"}]}], "}"}]}], "\n",
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["A", "2"], "-",
        RowBox[{"3", " ", "A"}], "+", "delta"}], "\[Equal]", "0"}], ",",
      RowBox[{
       RowBox[{"B", "-",
        RowBox[{"psi", " ", "A"}]}], "\[Equal]", "0"}]}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"A", ",", "B"}], "}"}], ",", "\n", "  ",
    RowBox[{"Assumptions", "\[Rule]",
     RowBox[{
      RowBox[{"delta", ">", "0"}], "&&",
      RowBox[{"psi", ">", "0"}]}]}]}], "]"}]}], "\n",
 RowBox[{
  RowBox[{"result", "[", "\"\<Conditions\>\"", "]"}], " ",
  RowBox[{"(*", " ",
   RowBox[{
   "Uses", " ", "custom", " ", "assumptions", " ", "instead", " ", "of", " ",
     "defaults"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[7]:=",
 CellID->469012345,ExpressionUUID->"d4e5f6a7-b8c9-d0e1-f2a3-b4c5d6e7f8a9"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{
    FractionBox["9", "4"], "-", "delta"}], "\[GreaterEqual]", "0"}],
  "}"}]], "Output",
 CellLabel->"Out[9]=",
 CellID->470123456,ExpressionUUID->"e5f6a7b8-c9d0-e1f2-a3b4-c5d6e7f8a9b0"]

}, Open  ]],

Cell[TextData[{
 "Default assumptions include constraints on ",
 Cell[BoxData["delta"], "InlineFormula",ExpressionUUID->
  "f6a7b8c9-d0e1-f2a3-b4c5-d6e7f8a9b0c1"],
 ", ",
 Cell[BoxData["psi"], "InlineFormula",ExpressionUUID->
  "a8b9c0d1-e2f3-a4b5-c6d7-e8f9a0b1c2d3"],
 ", ",
 Cell[BoxData["gamma"], "InlineFormula",ExpressionUUID->
  "b9c0d1e2-f3a4-b5c6-d7e8-f9a0b1c2d3e4"],
 ", ",
 Cell[BoxData["theta"], "InlineFormula",ExpressionUUID->
  "c0d1e2f3-a4b5-c6d7-e8f9-a0b1c2d3e4f5"],
 ", and persistence parameters. Use custom Assumptions to override."
}], "ExampleText",
 CellID->471234567,ExpressionUUID->"d1e2f3a4-b5c6-d7e8-f9a0-b1c2d3e4f5a6"]

}, Open  ]]

}, Open  ]]

}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "a1a2a3a4-b5b6-c7d8-e9f0-a1b2c3d4e5f6"],
  $Line = 0; Null]], "ExampleSection",
 CellID->472345678,ExpressionUUID->"b2b3c4d5-e6f7-a8b9-c0d1-e2f3a4b5c6d7"],

Cell["Overdetermined systems may fail:", "ExampleText",
 CellID->473456789,ExpressionUUID->"c3d4e5f6-a7b8-c9d0-e1f2-a3b4c5d6e7f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParamQuadSolve", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "\[Equal]", "4"}], ",",
     RowBox[{
      SuperscriptBox["x", "2"], "\[Equal]", "9"}], ",",
     RowBox[{"y", "\[Equal]", "x"}]}], "}"}], ",",
   RowBox[{"{",
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->474567890,ExpressionUUID->"d4e5f6a7-b8c9-d0e1-f2a3-b4c5d6e7f8a9"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{"\"\<Error\>\"", "\[Rule]",
   "\"\<Timeout or failure during solving\>\""}],
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->475678901,ExpressionUUID->"e5f6a7b8-c9d0-e1f2-a3b4-c5d6e7f8a9b0"]

}, Open  ]],

Cell["Conflicting discriminant conditions return Or expressions:", \
"ExampleText",
 CellID->476789012,ExpressionUUID->"f6a7b8c9-d0e1-f2a3-b4c5-d6e7f8a9b0c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "2"], "+",
        RowBox[{"a", " ", "x"}], "+", "b"}], "\[Equal]", "0"}], ",",
      RowBox[{
       RowBox[{
        SuperscriptBox["y", "2"], "+",
        RowBox[{"c", " ", "y"}], "+", "d"}], "\[Equal]", "0"}]}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "\n",
 RowBox[{"result", "[", "\"\<Conditions\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->477890123,ExpressionUUID->"a7b8c9d0-e1f2-a3b4-c5d6-e7f8a9b0c1d2"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["a", "2"], "-",
     RowBox[{"4", " ", "b"}]}], "\[GreaterEqual]", "0"}], "||",
   RowBox[{
    RowBox[{
     SuperscriptBox["c", "2"], "-",
     RowBox[{"4", " ", "d"}]}], "\[GreaterEqual]", "0"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->478901234,ExpressionUUID->"b8c9d0e1-f2a3-a4b5-c6d7-e8f9a0b1c2d3"]

}, Open  ]],

Cell["Inconsistent systems return with leftover equations:", "ExampleText",
 CellID->479012345,ExpressionUUID->"c9d0e1f2-a3b4-c5d6-e7f8-a9b0c1d2e3f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], "\[Equal]", "4"}], ",",
      RowBox[{"x", "\[Equal]", "3"}]}], "}"}], ",",
    RowBox[{"{", "x", "}"}], ",",
    RowBox[{"Diagnostics", "\[Rule]", "True"}]}], "]"}]}], "\n",
 RowBox[{
  RowBox[{"result", "[", "\"\<Diagnostics\>\"", "]"}], "[",
  "\"\<LeftoverEquations\>\"", "]"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->480123456,ExpressionUUID->"d0e1f2a3-b4c5-d6e7-f8a9-a0b1c2d3e4f5"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"4", "-",
   SuperscriptBox["x", "2"]}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->481234567,ExpressionUUID->"e1f2a3b4-c5d6-e7f8-a9b0-c1d2e3f4a5b6"]

}, Open  ]],

