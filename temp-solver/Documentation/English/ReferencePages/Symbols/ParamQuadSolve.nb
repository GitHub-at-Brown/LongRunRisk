       SuperscriptBox["x", "2"], "\[Equal]", "4"}], ",",
      RowBox[{"y", "\[Equal]",
       RowBox[{"2", "x"}]}]}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"x", ",", "y"}], "}"}], ",",
