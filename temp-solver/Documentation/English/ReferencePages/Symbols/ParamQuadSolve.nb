Cell["Solve a system with two independent radicals:", "ExampleText",
 CellID->336789012,ExpressionUUID->"c5d4e3f2-a1b0-c9d8-e7f6-a5b4c3d2e1f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "-", "5"}], "\[Equal]", "0"}], ",",
    RowBox[{
     RowBox[{
      SuperscriptBox["y", "2"], "-", "13"}], "\[Equal]", "0"}]}],
   "}"}]}], "\n",
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{"eqns", ",",
    RowBox[{"{",
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->347890123,ExpressionUUID->"d6e5f4a3-b2c1-d0e9-f8a7-b6c5d4e3f2a1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\"\<Solution\>\"", "\[Rule]",
    RowBox[{"{",
     RowBox[{
      RowBox[{"x", "\[Rule]",
       RowBox[{
        RowBox[{"signA", "[", "1", "]"}], " ",
        SqrtBox["5"]}]}], ",",
      RowBox[{"y", "\[Rule]",
       RowBox[{
        RowBox[{"signA", "[", "2", "]"}], " ",
        SqrtBox["13"]}]}]}], "}"}]}], ",",
   RowBox[{"\"\<SignRootMap\>\"", "\[Rule]",
    RowBox[{"\[LeftAssociation]",
     RowBox[{
      RowBox[{
       RowBox[{"signA", "[", "1", "]"}], "\[Rule]",
       SqrtBox["5"]}], ",",
      RowBox[{
       RowBox[{"signA", "[", "2", "]"}], "\[Rule]",
       SqrtBox["13"]}]}], "\[RightAssociation]"}]}], ",",
   RowBox[{"\"\<Conditions\>\"", "\[Rule]",
    RowBox[{"{",
     RowBox[{
      RowBox[{"5", "\[GreaterEqual]", "0"}], ",",
      RowBox[{"13", "\[GreaterEqual]", "0"}]}], "}"}]}], ",",
   RowBox[{"\"\<Verification\>\"", "\[Rule]",
    RowBox[{"{",
     RowBox[{"True", ",", "True"}], "}"}]}]}], "\[RightAssociation]"}]], \
"Output",
 CellLabel->"Out[2]=",
 CellID->358901234,ExpressionUUID->"e7f6a5b4-c3d2-e1f0-a9b8-c7d6e5f4a3b2"],

Cell[TextData[{
 "With two sign variables, there are ",
 Cell[BoxData[
  SuperscriptBox["2", "2"]], "InlineFormula",ExpressionUUID->
  "f8a7b6c5-d4e3-f2a1-b0c9-d8e7f6a5b4c3"],
 " = 4 solution branches."
}], "ExampleText",
 CellID->369012345,ExpressionUUID->"a9b8c7d6-e5f4-a3b2-c1d0-e9f8a7b6c5d4"]

}, Open  ]],

Cell["Solve a system with bilinear terms:", "ExampleText",
 CellID->369512346,ExpressionUUID->"aa18c7d7-e6f5-a4b3-c2d1-e0f9a8b7c6d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "+",
      RowBox[{"x", " ", "y"}]}], "\[Equal]", "5"}], ",",
    RowBox[{
     RowBox[{
      SuperscriptBox["y", "2"], "-",
      RowBox[{"x", " ", "y"}]}], "\[Equal]", "3"}]}], "}"}]}], "\n",
 RowBox[{"result", "=",
  RowBox[{"ParamQuadSolve", "[",
   RowBox[{"eqns", ",",
    RowBox[{"{",
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->369612347,ExpressionUUID->"ab28c8d8-e7f6-a5b4-c3d2-e1f0a9b8c7d7"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]",
  RowBox[{
   RowBox[{"\"\<Solution\>\"", "\[Rule]",
    RowBox[{"{",
     RowBox[{
      RowBox[{"x", "\[Rule]",
       RowBox[{
        FractionBox[
         RowBox[{"-", "y"}], "2"], "+",
        FractionBox[
         RowBox[{
          RowBox[{"signA", "[", "1", "]"}], " ",
          SqrtBox[
           RowBox[{
            RowBox[{"20", " ", "y"}], "+",
            SuperscriptBox["y", "2"]}]]}], "2"]}]}], ",",
      RowBox[{"y", "\[Rule]",
       RowBox[{
        RowBox[{"signA", "[", "2", "]"}], " ",
        SqrtBox["3"]}]}]}], "}"}]}], ",",
   RowBox[{"\"\<SignRootMap\>\"", "\[Rule]",
    RowBox[{"\[LeftAssociation]",
     RowBox[{
      RowBox[{
       RowBox[{"signA", "[", "1", "]"}], "\[Rule]",
       SqrtBox[
        RowBox[{
         RowBox[{"20", " ", "y"}], "+",
         SuperscriptBox["y", "2"]}]]}], ",",
      RowBox[{
       RowBox[{"signA", "[", "2", "]"}], "\[Rule]",
       SqrtBox["3"]}]}], "\[RightAssociation]"}]}], ",",
   RowBox[{"\"\<Verification\>\"", "\[Rule]",
    RowBox[{"{",
     RowBox[{"True", ",", "True"}], "}"}]}]}], "\[RightAssociation]"}]], \
"Output",
 CellLabel->"Out[4]=",
 CellID->369712348,ExpressionUUID->"ac38c9d9-e8f7-a6b5-c4d3-e2f1a0b9c8d8"]

}, Open  ]],

