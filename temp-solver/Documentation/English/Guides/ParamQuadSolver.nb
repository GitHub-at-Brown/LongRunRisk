Notebook[{
Cell[CellGroupData[{
Cell["ParamQuadSolver", "GuideTitle",
 CellID->942062912,ExpressionUUID->"8f2a3c5d-9e41-4f29-b8e2-1a3d5e7f9c4b"],

Cell["Symbolic solver for square systems of polynomial equations with parametric coefficients. Solves systems where each equation is at most quadratic in each variable with no cross-terms.", "GuideAbstract",
 CellID->123456789,ExpressionUUID->"a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d"]
}, Open  ]],

Cell[CellGroupData[{
Cell["Core Functions", "GuideFunctionsSection",
 CellID->876543210,ExpressionUUID->"b2c3d4e5-6f7a-8b9c-0d1e-2f3a4b5c6d7e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ParamQuadSolve",
   BaseStyle->"Link",
   ButtonData->"paclet:LongRunRisk/ref/ParamQuadSolve"]], "InlineGuideFunction",
  ExpressionUUID->"c3d4e5f6-7a8b-9c0d-1e2f-3a4b5c6d7e8f"],
 " \[LongDash] Solve square systems of polynomial equations with parametric coefficients and return solutions with sign variables representing multiple branches."
}], "GuideText",
 CellID->234567890,ExpressionUUID->"d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a"]
}, Open  ]],

Cell[CellGroupData[{
Cell["Sign Variables", "GuideFunctionsSubsection",
 CellID->345678901,ExpressionUUID->"e5f6a7b8-9c0d-1e2f-3a4b-5c6d7e8f9a0b"],

Cell["\<\
Sign variables represent the \[PlusMinus] choice in square roots from the \
quadratic formula. Each sign variable can be +1 or -1.\
\>", "GuideText",
 CellID->456789012,ExpressionUUID->"f6a7b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c"],

Cell["\<\
For a system with N independent radicals, there are 2^N solution branches, \
which can be enumerated using Tuples.\
\>", "GuideText",
 CellID->567890123,ExpressionUUID->"a7b8c9d0-1e2f-3a4b-5c6d-7e8f9a0b1c2d"]
}, Open  ]],

Cell[CellGroupData[{
Cell["Return Value Structure", "GuideFunctionsSubsection",
 CellID->678901234,ExpressionUUID->"b8c9d0e1-2f3a-4b5c-6d7e-8f9a0b1c2d3e"],

Cell["The solver returns an Association with the following keys:", "GuideText",
 CellID->789012345,ExpressionUUID->"c9d0e1f2-3a4b-5c6d-7e8f-9a0b1c2d3e4f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"Solution\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d0e1f2a3-4b5c-6d7e-8f9a-0b1c2d3e4f5a"],
 " \[LongDash] Replacement rules mapping variables to parametric expressions with sign variables"
}], "GuideText",
 CellID->890123456,ExpressionUUID->"e1f2a3b4-5c6d-7e8f-9a0b-1c2d3e4f5a6b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"SignRootMap\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f2a3b4c5-6d7e-8f9a-0b1c-2d3e4f5a6b7c"],
 " \[LongDash] Association mapping each sign variable to its corresponding square root expression"
}], "GuideText",
 CellID->901234567,ExpressionUUID->"a3b4c5d6-7e8f-9a0b-1c2d-3e4f5a6b7c8d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"Conditions\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"b4c5d6e7-8f9a-0b1c-2d3e-4f5a6b7c8d9e"],
 " \[LongDash] Domain and feasibility conditions (e.g., discriminant \[GreaterEqual] 0 for real solutions)"
}], "GuideText",
 CellID->123450987,ExpressionUUID->"c5d6e7f8-9a0b-1c2d-3e4f-5a6b7c8d9e0f"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"Verification\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"d6e7f8a9-0b1c-2d3e-4f5a-6b7c8d9e0f1a"],
 " \[LongDash] Boolean list indicating whether each equation is satisfied"
}], "GuideText",
 CellID->234561098,ExpressionUUID->"e7f8a9b0-1c2d-3e4f-5a6b-7c8d9e0f1a2b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["\"CoeffMap\"", "InlineCode"]], "InlineFormula",
  ExpressionUUID->"f8a9b0c1-2d3e-4f5a-6b7c-8d9e0f1a2b3c"],
 " \[LongDash] Internal mapping from dummy coefficients to original expressions"
}], "GuideText",
 CellID->345672109,ExpressionUUID->"a9b0c1d2-3e4f-5a6b-7c8d-9e0f1a2b3c4d"]
}, Open  ]],

