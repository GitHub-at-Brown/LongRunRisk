Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", "t", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "mup"}], "+", 
      RowBox[{"pi", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"sg", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "Esg"}], "+", 
      RowBox[{"sg", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["phip", "2"], " ", 
          SuperscriptBox["rhogp", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["Esp", "2"], " ", 
          SuperscriptBox["phipbarpb", "2"], " ", 
