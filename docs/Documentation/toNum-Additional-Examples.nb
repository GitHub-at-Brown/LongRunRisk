 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", "t", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "mup"}], "+", 
      RowBox[{"pi", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"sg", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}], ",", 
