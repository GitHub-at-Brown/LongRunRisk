Cell["\<\
Related functions - toEquation rewrites expressions symbolically:\
\>", "ExampleText",ExpressionUUID->"d2692f44-f166-49f4-b88b-708764e680d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToEquation", "[", 
  RowBox[{
   RowBox[{"wc", "[", "t", "]"}], ",", "byModel"}], "]"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"ca5f7303-65ea-449a-b125-03026881d05f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", "0", "]"}], "+", 
  RowBox[{
   RowBox[{"A", "[", "2", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vx", " ", 
      RowBox[{"sx", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phisxs", " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"sx\"\>", "]"}], "[", "t", "]"}]}]}], ")"}]}], 
  "+", 
  RowBox[{
   RowBox[{"A", "[", "1", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"rhox", " ", 
      RowBox[{"x", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phix", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["Esx", "2"], "+", 
        RowBox[{"sx", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "t"}], "]"}]}]], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"x\"\>", "]"}], "[", "t", "]"}]}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{3.977100729362074*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"2852712f-9158-4f79-8271-c992f97ddcc2"]
}, Open  ]]
}, Open  ]],

