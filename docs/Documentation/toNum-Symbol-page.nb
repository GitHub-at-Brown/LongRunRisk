Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"nrcModel", "[", "\"\<numStocks\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nrcModel", "[", "\"\<stateVars\>\"", "]"}]}], "Input",
 CellLabel->
  "In[104]:=",ExpressionUUID->"5975c5a4-45c4-4432-933b-824863a56ece"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{3.9770794952440042`*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"d09be7fd-3f03-4f4f-adce-20f71126fb46"],

Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", "t", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "mup"}], "+", 
      RowBox[{"pi", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"sg", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "Esg"}], "+", 
      RowBox[{"sg", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["Esg", "2"]}], "-", 
      FractionBox[
       SuperscriptBox["phig", "2"], 
       RowBox[{"1", "-", 
        SuperscriptBox["rhog", "2"]}]], "+", 
      SuperscriptBox[
       RowBox[{"sg", "[", "t", "]"}], "2"]}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.977079495244731*^9},
 CellLabel->
  "Out[105]=",ExpressionUUID->"c80d9d45-a9a1-4e7e-b836-6d98aa0f668d"]
}, Open  ]],

