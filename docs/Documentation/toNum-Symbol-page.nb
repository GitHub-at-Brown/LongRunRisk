Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{
   RowBox[{"{", "t", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], ",", 
     RowBox[{"sx", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "mupbar"}], "+", 
      RowBox[{"pibar", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"sg", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"eps", "[", "\<\"pi\"\>", "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "Esg"}], "+", 
      RowBox[{"sg", "[", "t", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["Esg", "2"]}], "-", 
      FractionBox[
       SuperscriptBox["phig", "2"], 
       RowBox[{"1", "-", 
