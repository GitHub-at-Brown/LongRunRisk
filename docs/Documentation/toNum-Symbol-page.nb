Cell["\<\
toEquation rewrites expressions in terms of lagged exogenous variables and \
shocks:\
\>", "ExampleText",ExpressionUUID->"4ec3c3b1-f2a9-4f3d-b8f8-184a15a3832a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToEquation", "[", 
  RowBox[{
   RowBox[{"wc", "[", "t", "]"}], ",", "byModel"}], "]"}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"67bca0a4-75a9-46ce-94ab-3a36ffdb4a2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", "0", "]"}], "+", 
  RowBox[{
   RowBox[{"A", "[", "2", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vx", " ", 
      RowBox[{"sx", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phisxs", " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"sx\"\>", "]"}], "[", "t", "]"}]}]}], ")"}]}], 
  "+", 
  RowBox[{
   RowBox[{"A", "[", "1", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"rhox", " ", 
      RowBox[{"x", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phix", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["Esx", "2"], "+", 
        RowBox[{"sx", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "t"}], "]"}]}]], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"x\"\>", "]"}], "[", "t", "]"}]}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{3.977079498947598*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"52c118ab-5421-4f01-859b-664280e72b6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToEquation", "[", 
  RowBox[{
   RowBox[{"pd", "[", 
    RowBox[{"1", ",", "t"}], "]"}], ",", "byModel"}], "]"}]], "Input",
 CellChangeTimes->{{3.977078283430217*^9, 3.977078284477145*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"89f3d2b3-0c5e-4ad4-a58c-2785660bae7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "t", "]"}], "[", "0", "]"}], "+", 
  RowBox[{
   RowBox[{
    RowBox[{"B", "[", "t", "]"}], "[", "2", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vx", " ", 
      RowBox[{"sx", "[", "0", "]"}]}], "+", 
     RowBox[{"phisxs", " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"sx\"\>", "]"}], "[", "1", "]"}]}]}], ")"}]}], 
  "+", 
  RowBox[{
   RowBox[{
    RowBox[{"B", "[", "t", "]"}], "[", "1", "]"}], " ", 
