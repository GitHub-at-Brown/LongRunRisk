Cell["\<\
Related functions - toEquation rewrites expressions symbolically:\
\>", "ExampleText",ExpressionUUID->"d2692f44-f166-49f4-b88b-708764e680d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ToEquation", "[", 
  RowBox[{
   RowBox[{"wc", "[", "t", "]"}], ",", "byModel"}], "]"}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"ca5f7303-65ea-449a-b125-03026881d05f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", "0", "]"}], "+", 
  RowBox[{
   RowBox[{"A", "[", "2", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vx", " ", 
      RowBox[{"sx", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phisxs", " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"sx\"\>", "]"}], "[", "t", "]"}]}]}], ")"}]}], 
  "+", 
  RowBox[{
   RowBox[{"A", "[", "1", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"rhox", " ", 
      RowBox[{"x", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "t"}], "]"}]}], "+", 
     RowBox[{"phix", " ", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["Esx", "2"], "+", 
        RowBox[{"sx", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "t"}], "]"}]}]], " ", 
      RowBox[{
       RowBox[{"eps", "[", "\<\"x\"\>", "]"}], "[", "t", "]"}]}]}], 
    ")"}]}]}]], "Output",
 CellChangeTimes->{3.977079494478365*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"b51468cb-7ef2-4238-bb39-6f67c78c57e8"]
}, Open  ]]
}, Open  ]],

