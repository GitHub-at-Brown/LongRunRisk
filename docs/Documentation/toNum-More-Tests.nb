Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "baseRules", ",", "overrideRules", ",", "gammaBase", ",", 
     "gammaOverride"}], "}"}], ",", 
   RowBox[{
    RowBox[{"baseRules", "=", 
     RowBox[{"ToNum", "[", 
      RowBox[{"\"\<Rules\>\"", ",", "$modBY"}], "]"}]}], ";", 
    RowBox[{"overrideRules", "=", 
     RowBox[{"ToNum", "[", 
      RowBox[{"\"\<Rules\>\"", ",", "$modBY", ",", 
       RowBox[{"{", 
        RowBox[{"gamma", "\[Rule]", "15.`"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"gammaBase", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"baseRules", ",", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"gamma", "\[Rule]", "v_"}], "]"}], "\[RuleDelayed]", "v"}], ",",
        "\[Infinity]"}], "]"}]}], ";", 
    RowBox[{"gammaOverride", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"overrideRules", ",", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"gamma", "\[Rule]", "v_"}], "]"}], "\[RuleDelayed]", "v"}], ",",
        "\[Infinity]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "gammaBase", "]"}], ">", "0"}], "&&", 
     RowBox[{
      RowBox[{"Length", "[", "gammaOverride", "]"}], ">", "0"}], "&&", 
     RowBox[{
      RowBox[{"First", "[", "gammaBase", "]"}], "!=", 
      RowBox[{"First", "[", "gammaOverride", "]"}]}]}]}]}], 
  "]"}]], "VerificationTest",
