Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"largeExpr", ",", "largeResult"}], "}"}], ",", 
   RowBox[{
    RowBox[{"largeExpr", "=", 
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "0"}], "2"], 
       RowBox[{"A", "[", "i", "]"}]}], "+", 
      RowBox[{
       RowBox[{"B", "[", "1", "]"}], "[", "0", "]"}], "+", 
      RowBox[{
       RowBox[{"B", "[", "1", "]"}], "[", "1", "]"}], "+", 
      RowBox[{
       RowBox[{"B", "[", "1", "]"}], "[", "2", "]"}]}]}], ";", 
    RowBox[{"largeResult", "=", 
     RowBox[{"ToNum", "[", 
      RowBox[{"largeExpr", ",", "$modBY"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"NumericQ", "[", "largeResult", "]"}], "&&", 
     RowBox[{"!", 
      RowBox[{"FailureQ", "[", "largeResult", "]"}]}]}]}]}], 
  "]"}]], "VerificationTest",
 CellLabel->"In[13]:=",
 CellID->120595702,ExpressionUUID->"6d92f369-a138-431c-9c72-12eb9a121fed"],

