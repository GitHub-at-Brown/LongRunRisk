Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"exprTest", ",", "baseExprValue", ",", "overrideExprValue"}], 
    "}"}], ",", 
   RowBox[{
    RowBox[{"exprTest", "=", 
     RowBox[{
      RowBox[{"A", "[", "0", "]"}], "+", 
      RowBox[{"A", "[", "1", "]"}]}]}], ";", 
    RowBox[{"baseExprValue", "=", 
     RowBox[{"ToNum", "[", 
      RowBox[{"exprTest", ",", "$modBY"}], "]"}]}], ";", 
    RowBox[{"overrideExprValue", "=", 
     RowBox[{"ToNum", "[", 
      RowBox[{"exprTest", ",", "$modBY", ",", 
       RowBox[{"{", 
        RowBox[{"gamma", "\[Rule]", "20.`"}], "}"}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"NumericQ", "[", "baseExprValue", "]"}], "&&", 
     RowBox[{"NumericQ", "[", "overrideExprValue", "]"}], "&&", 
     RowBox[{"baseExprValue", "\[NotEqual]", "overrideExprValue"}]}]}]}], 
  "]"}]], "VerificationTest",
 CellLabel->"In[10]:=",
 CellID->652858484,ExpressionUUID->"a2780ea0-49a8-46a0-af28-d4a7d349e08c"],

