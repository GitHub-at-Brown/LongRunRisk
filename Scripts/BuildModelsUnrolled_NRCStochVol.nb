(*Section 6: Phase 2 - Compilation*)

(* ::Text:: *)
(*This phase compiles the symbolic equations to optimized .mx files for fast numerical evaluation.*)

Cell[BoxData[{
 RowBox[{"(* Phase 2: Compile equations to .mx files *)"}], "\n",
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n=== Phase 2: Compilation ===\"", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{"Print", "[",
   RowBox[{"\"\<Output directory: \>\"", ",", "compiledDir"}], "]"}], ";"}]}], "Input",
 CellLabel->"In[149]:="],

Cell[BoxData[{
 RowBox[{"(* Ensure compiled directory exists *)"}], "\n",
 RowBox[{
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"!",
     RowBox[{"DirectoryQ", "[", "compiledDir", "]"}]}], ",", "\n", "  ",
    RowBox[{"CreateDirectory", "[",
     RowBox[{"compiledDir", ",",
      RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[151]:="],

