(* ::Section:: *)
(*5.11 Add Coefficient Solution (Bond Recursions)*)

Cell[BoxData[{
 RowBox[{"(* Create bond recursion closures using RecurrenceTable *)"}], "\n",
 RowBox[{
  RowBox[{"Print", "[", "\"\<Creating bond coefficient recursion closures...\>\"", "]"}], ";"}]}], "Input",
 CellLabel->"In[141]:="],

Cell[BoxData[{
 RowBox[{"(* The bond coefficients R[n] and P[n] are computed recursively *)"}], "\n",
 RowBox[{"(* This creates closures that can compute them for any maturity n *)"}], "\n",
 RowBox[{
  RowBox[{"bondRecursionClosure", "=",
   RowBox[{"Module", "[",
    RowBox[{
     RowBox[{"{", "recursion", "}"}], ",", "\n", "    ",
     RowBox[{
      RowBox[{"recursion", "=", "bondCoeffSystem"}], ";", "\n", "    ",
      RowBox[{"Function", "[",
       RowBox[{
        RowBox[{"{", "maxN", "}"}], ",", "\n", "      ",
        RowBox[{"RecurrenceTable", "[",
         RowBox[{"recursion", ",",
          RowBox[{"{", "n", ",", "1", ",", "maxN", "}"}]}], "]"}]}], "]"}]}]}], "\n", "  ", "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"model", "=",
   RowBox[{"Append", "[",
    RowBox[{"model", ",",
     RowBox[{"\"\<bondRecursion\>\"", "->", "bondRecursionClosure"}]}], "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"Print", "[", "\"\<Bond recursion closure created.\>\"", "]"}], ";"}]}], "Input",
 CellLabel->"In[142]:="],

Cell[BoxData[{
 RowBox[{"(* Store catalog hash for tracking changes *)"}], "\n",
 RowBox[{
  RowBox[{"catalogHash", "=",
   RowBox[{"getCanonicalHash", "[",
    RowBox[{"catalogModels", "[", "targetModel", "]"}], "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"model", "=",
   RowBox[{"Append", "[",
    RowBox[{"model", ",",
     RowBox[{"\"\<catalogHash\>\"", "->", "catalogHash"}]}], "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\n=== Phase 1 (Symbolic) Complete ===\"", "]"}], ";"}], "\n",
 RowBox[{
  RowBox[{"Print", "[",
   RowBox[{"\"\<Model keys: \>\"", ",",
    RowBox[{"Keys", "[", "model", "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[145]:="],

