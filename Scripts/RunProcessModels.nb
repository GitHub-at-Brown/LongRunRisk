     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"wcCoeffs", "[", 
       RowBox[{"[", " ", "1", " ", "]"}], "]"}]}]}]}], "\n", 
   "                    ", 
   RowBox[{"pdCoeffName", " ", "=", " ", 
    RowBox[{"SymbolName", " ", "@", " ", 
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"Head", " ", "@", " ", 
       RowBox[{"pdSys", "[", 
        RowBox[{"[", " ", 
         RowBox[{"2", ",", " ", "1"}], " ", "]"}], "]"}]}]}]}]}], "\n", 
   "                    ", 
   RowBox[{"wcSigns", " ", "=", " ", 
    RowBox[{"Keys", " ", "@", " ", "wcSignRootMap"}]}], "\n", 
