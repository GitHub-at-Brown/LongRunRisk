            RowBox[{"1", "-", "gamma"}], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox["1", "psi"]}], ")"}]], "==", "theta"}], ",", "#"}], 
         "]"}], "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"psi", ",", "gamma", ",", "theta"}], "}"}]}], ",", "1"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sysA", "=", 
