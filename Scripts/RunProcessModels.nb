     RowBox[{"model", "[", " ", "\"\<params\>\"", " ", "]"}]}]}], "\n", 
   "            ", 
   RowBox[{"shortname", " ", "=", " ", 
    RowBox[{"model", "[", " ", "\"\<shortname\>\"", " ", "]"}]}], "\n", 
   "            ", 
