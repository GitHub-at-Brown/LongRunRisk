Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ClearAll", "[", 
      RowBox[{
      "simplifySys", ",", "cancelDen", ",", "expr", ",", "ass", ",", 
       "tryTransforms", ",", "transforms", ",", "results"}], "]"}], "\[IndentingNewLine]", 
     RowBox[{"simplifySys", "[", 
      RowBox[{"sys_", ",", "ass_"}], "]"}]}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"assume", ",", "sysSimp", ",", "tr"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"assume", "=", 
          RowBox[{
          "FernandoDuarte`LongRunRisk`ComputationalEngine`ParamQuadSolve`\
Private`expandPatternAssumptions", "[", 
           RowBox[{"sys", ",", "ass"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sysSimp", "=", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"sys", ",", 
            RowBox[{"Assumptions", "->", "assume"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sysSimp", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"cancelDen", "[", 
             RowBox[{"#", ",", "assume"}], "]"}], "&"}], "/@", "sysSimp"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"tr", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"1", "-", "gamma"}], 
                  RowBox[{"1", "-", 
                   FractionBox["1", "psi"]}]], "==", "theta"}], ",", "#"}], 
               "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"psi", ",", "gamma", ",", "theta"}], "}"}]}], ",", 
            "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sysSimp", "=", 
          RowBox[{"tryTransforms", "[", 
           RowBox[{"sysSimp", ",", "tr", ",", "assume"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "sysSimp", "}"}]}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Attributes", "[", "cancelDen", "]"}], "=", 
         RowBox[{"{", 
          RowBox[{"Listable", ",", "HoldRest"}], "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cancelDen", "[", 
       RowBox[{"expr_", ",", 
        RowBox[{"ass_", ":", "True"}]}], "]"}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"exprTogether", ",", "num", ",", "den", ",", "nonZeroDen"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exprTogether", "=", 
         RowBox[{
          RowBox[{"Together", "@", "Subtract"}], "@@", "expr"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"num", "=", 
         RowBox[{"Numerator", "[", "exprTogether", "]"}]}], ";", "\n", "  ", 
        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", "exprTogether", "]"}]}], ";", "\n", 
        "   ", 
        RowBox[{"nonZeroDen", "=", 
         RowBox[{"TrueQ", "@", 
          RowBox[{"Not", "@", 
           RowBox[{"Reduce", "[", 
            RowBox[{
             RowBox[{"den", "==", "0"}], " ", "&&", " ", "ass"}], "]"}]}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"nonZeroDen", ",", 
          RowBox[{"num", "==", "0"}], ",", "expr"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Attributes", "[", "tryTransforms", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{"Listable", ",", "HoldRest"}], "}"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tryTransforms", "[", 
     RowBox[{"expr_", ",", " ", 
      RowBox[{"transforms_List", " ", "/;", " ", 
       RowBox[{"VectorQ", "[", 
        RowBox[{"transforms", ",", " ", "ListQ"}], "]"}]}], ",", " ", 
