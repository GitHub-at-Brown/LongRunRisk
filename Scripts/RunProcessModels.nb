Cell[BoxData[{
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"solN", "=", 
      RowBox[{
      "FernandoDuarte`LongRunRisk`ComputationalEngine`SolveEulerEq`\
addCoeffsSolutionN", "[", 
       RowBox[{
        RowBox[{"phase3", "[", "\"\<processedModels\>\"", "]"}], "[", 
        "shortname", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"processedModels", "[", "shortname", "]"}], "=", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"processedModels", "[", "shortname", "]"}], ",", 
        RowBox[{"\"\<coeffsSolutionN\>\"", "->", "solN"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{
      "Verify", " ", "coeffsSolutionN", " ", "was", " ", "computed", " ", 
       "correctly"}], "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"validCoeffsSolutionN", "[", 
         RowBox[{"processedModels", "[", "shortname", "]"}], "]"}]}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<WARNING: coeffsSolutionN validation failed for \>\"", ",",
          "shortname", ",", "\"\<; Keys: \>\"", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AssociationQ", "[", "solN", "]"}], ",", 
           RowBox[{"Keys", "[", "solN", "]"}], ",", 
           RowBox[{"Head", "[", "solN", "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Checkpoint", " ", "after", " ", "each", " ", 
    RowBox[{"model", "'"}], "s", " ", "numerical", " ", "solutions"}], "*)"}], 
  RowBox[{
   RowBox[{"saveModels", "[", 
    RowBox[{
     RowBox[{"Merge", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"savedModels", ",", "processedModels"}], "}"}], ",", "Last"}],
       "]"}], ",", "modelsFileCheckpoint"}], "]"}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{"logMemory", "[", 
   RowBox[{"\"\<Phase3 END: \>\"", "<>", "shortname"}], "]"}], 
  ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.974392767750709*^9, 3.9743927677515306`*^9}, {
