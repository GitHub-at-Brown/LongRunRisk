   RowBox[{"pdVars", " ", "=", " ", 
    RowBox[{"quadSolPd", "[", "\"\<varsB0\>\"", "]"}]}], "\n", 
   "                    ", 
   RowBox[{"eqMap", " ", "=", " ", 
    RowBox[{"<|", "\n", "                            ", 
     RowBox[{
      RowBox[{"\"\<A\>\"", " ", "->", " ", 
       RowBox[{"<|", "\n", "                                ", 
        RowBox[{
         RowBox[{"\"\<Expr\>\"", " ", "->", "  ", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Head", "[", "#", "]"}], "===", "Equal"}], ",", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "#", "]"}], "==", "2"}], ",", " ", 
                 RowBox[{"Subtract", " ", "@@", " ", "#"}], ",", " ", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   
                   RowBox[{"\"\<Error: Equal with != 2 args in A: \>\"", ",", 
                    " ", "#"}], "]"}], ";", " ", "#"}]}], "]"}], ",", " ", 
               "#"}], "]"}], "&"}], ",", " ", 
            RowBox[{"quadSolWc", "[", " ", "\"\<eqA0\>\"", " ", "]"}]}], " ", 
           "]"}]}], ",", "\n", "                                ", 
         RowBox[{"\"\<Vars\>\"", " ", "->", " ", "wcVars"}], ",", "\n", 
         "                                ", 
