   "                ", 
   RowBox[{"quadSolPd", " ", "=", " ", 
    RowBox[{"quadSol", "[", " ", "\"\<pd\>\"", " ", "]"}]}], "\n", 
   "                ", 
   RowBox[{"paramsA", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", " ", 
     RowBox[{"modelParamsKeys", ",", " ", 
      RowBox[{"ddHeads", "[", " ", "_", " ", "]"}]}], " ", "]"}]}], "\n", 
   "                    ", 
   RowBox[{"paramsStocks", " ", "=", " ", 
    RowBox[{"Cases", "[", " ", 
     RowBox[{"modelParamsKeys", ",", " ", 
      RowBox[{
       RowBox[{"x", ":", " ", 
        RowBox[{"ddHeads", "[", " ", "_", " ", "]"}]}], " ", ":>", " ", 
       RowBox[{
        RowBox[{"Head", "[", " ", "x", " ", "]"}], "[", " ", "j", " ", 
        "]"}]}]}], " ", "]"}]}], "\n", "                    ", 
   RowBox[{"wcCoeffs", " ", "=", " ", 
    RowBox[{"wcSys", "[", 
     RowBox[{"[", " ", "2", " ", "]"}], "]"}]}], "\n", "                    ", 
   RowBox[{"wcSignRootMap", " ", "=", " ", 
    RowBox[{"Normal", " ", "@", " ", 
     RowBox[{"quadSolWc", "[", " ", "\"\<SignRootMap\>\"", " ", "]"}]}]}], "\n",
    "                    ", 
   RowBox[{"wcCoeffName", " ", "=", " ", 
