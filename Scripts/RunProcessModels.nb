          RowBox[{
           RowBox[{
            RowBox[{"cancelDen", "[", 
             RowBox[{"#", ",", "assume"}], "]"}], "&"}], "/@", "sysSimp"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"tr", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"1", "-", "gamma"}], 
                  RowBox[{"1", "-", 
                   FractionBox["1", "psi"]}]], "==", "theta"}], ",", "#"}], 
               "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"psi", ",", "gamma", ",", "theta"}], "}"}]}], ",", 
            "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sysSimp", "=", 
          RowBox[{"tryTransforms", "[", 
           RowBox[{"sysSimp", ",", "tr", ",", "assume"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "sysSimp", "}"}]}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Attributes", "[", "cancelDen", "]"}], "=", 
         RowBox[{"{", 
          RowBox[{"Listable", ",", "HoldRest"}], "}"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cancelDen", "[", 
       RowBox[{"expr_", ",", 
        RowBox[{"ass_", ":", "True"}]}], "]"}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"exprTogether", ",", "num", ",", "den", ",", "nonZeroDen"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exprTogether", "=", 
