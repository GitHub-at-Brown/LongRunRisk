Cell[BoxData[{
 RowBox[{
  RowBox[{"tryTransforms", "[", 
   RowBox[{"expr_", ",", " ", 
    RowBox[{"transforms_List", " ", "/;", " ", 
     RowBox[{"VectorQ", "[", 
      RowBox[{"transforms", ",", " ", "ListQ"}], "]"}]}], ",", " ", 
    RowBox[{"ass", " ", ":", " ", 
     RowBox[{"Except", "[", "_List", "]"}], " ", ":", " ", "True"}]}], "]"}], 
  " ", ":=", "\n", "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "results", "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{"results", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"expr", " ", "/.", " ", "transform"}], ",", 
          RowBox[{"Assumptions", "->", "ass"}], ",", 
          RowBox[{"TimeConstraint", "->", 
           RowBox[{"{", 
            RowBox[{"5", ",", "300"}], "}"}]}]}], "]"}], ",", "\n", "      ", 
        
        RowBox[{"{", 
         RowBox[{"transform", ",", " ", "transforms"}], "}"}]}], "\n", "    ",
        "]"}]}], ";", "\n", "    ", 
     RowBox[{"First", "[", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{"results", ",", " ", "LeafCount", ",", " ", "1"}], "]"}], 
      "]"}]}]}], "\n", "  ", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tr", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
