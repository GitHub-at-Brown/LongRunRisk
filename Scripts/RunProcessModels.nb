   RowBox[{"paramsA", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", " ", 
     RowBox[{"modelParamsKeys", ",", " ", 
      RowBox[{"ddHeads", "[", " ", "_", " ", "]"}]}], " ", "]"}]}], "\n", 
   "                    ", 
   RowBox[{"paramsStocks", " ", "=", " ", 
