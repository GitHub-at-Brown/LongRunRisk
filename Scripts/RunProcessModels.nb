        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "-", 
           RowBox[{"fa", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], "/", "safeDiff"}]}]}], ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}], "]"}], "*", 
       RowBox[{"UnitStep", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "diff", "]"}], "-", "1.0*^-10"}], "]"}]}], "+", 
      RowBox[{"mid", "*", 
       RowBox[{"UnitStep", "[", 
