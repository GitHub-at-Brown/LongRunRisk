Cell[BoxData[
 RowBox[{"\n", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"opts", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "             ", 
   RowBox[{"quadSol", " ", "=", " ", 
    RowBox[{"model", "[", " ", "\"\<coeffsParamQuadSolve\>\"", " ", "]"}]}], "\n",
    "            ", 
   RowBox[{"modelParamsKeys", " ", "=", " ", 
    RowBox[{"Keys", " ", "@", " ", 
     RowBox[{"model", "[", " ", "\"\<params\>\"", " ", "]"}]}]}], "\n", 
   "            ", 
   RowBox[{"shortname", " ", "=", " ", 
    RowBox[{"model", "[", " ", "\"\<shortname\>\"", " ", "]"}]}], "\n", 
   "            ", 
   RowBox[{"buildKernelOpts", " ", "=", " ", 
    RowBox[{"Evaluate", " ", "@", " ", 
     RowBox[{"FilterRules", "[", " ", 
      RowBox[{
       RowBox[{"Flatten", " ", "@", " ", 
        RowBox[{"{", " ", "opts", " ", "}"}]}], ",", " ", 
       RowBox[{"Options", " ", "@", " ", "buildKernel"}]}], " ", "]"}]}]}], "\n",
    "            ", 
   RowBox[{"coeffsSystem", " ", "=", " ", 
    RowBox[{"model", "[", " ", "\"\<coeffsSystem\>\"", " ", "]"}]}], "\n", 
   "             ", 
   RowBox[{"ddHeads", " ", "=", " ", "\n", "                    ", 
    RowBox[{"Apply", "[", "\n", "                        ", 
     RowBox[{"Alternatives", ",", "\n", "                        ", 
      RowBox[{"Part", "[", "\n", "                            ", 
       RowBox[{
        RowBox[{
        "FernandoDuarte`LongRunRisk`Model`Parameters`Private`paramList", "[", 
         " ", "\"\<Real dividend growth\>\"", " ", "]"}], ",", "\n", 
        "                            ", "All", ",", "\n", 
        "                            ", "0"}], "\n", 
       "                        ", "]"}]}], "\n", "                    ", 
     "]"}]}], "\n", "                ", 
   RowBox[{"wcSys", " ", "=", " ", 
    RowBox[{"coeffsSystem", "[", " ", "\"\<wc\>\"", " ", "]"}]}], "\n", 
   "                ", 
   RowBox[{"pdSys", " ", "=", " ", 
    RowBox[{"coeffsSystem", "[", " ", "\"\<pd\>\"", " ", "]"}]}], "\n", 
   "                ", 
   RowBox[{"quadSolWc", " ", "=", " ", 
