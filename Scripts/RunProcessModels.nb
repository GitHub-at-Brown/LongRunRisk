        "                            ", "0"}], "\n", 
       "                        ", "]"}]}], "\n", "                    ", 
     "]"}]}], "\n", "                ", 
   RowBox[{"wcSys", " ", "=", " ", 
    RowBox[{"coeffsSystem", "[", " ", "\"\<wc\>\"", " ", "]"}]}], "\n", 
   "                ", 
   RowBox[{"pdSys", " ", "=", " ", 
