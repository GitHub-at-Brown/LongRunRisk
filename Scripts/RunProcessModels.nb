               "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"psi", ",", "gamma", ",", "theta"}], "}"}]}], ",", 
            "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
