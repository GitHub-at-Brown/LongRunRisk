Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stripPacletSearchIndices", "[", "file_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tmpDir", ",", " ", "pacletRootDir", ",", " ", "documentationDir", ",",
         " ", "indexDirs", ",", " ", "kernelDir", ",", " ", "initFile"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", "file", "]"}]}], ",", " ", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"tmpDir", " ", "=", " ", 
        RowBox[{"CreateDirectory", "[", "]"}]}], ";", "\n", "  ", 
       RowBox[{"ExtractArchive", "[", 
        RowBox[{"file", ",", " ", "tmpDir"}], "]"}], ";", "\n", "  ", 
       RowBox[{"pacletRootDir", " ", "=", " ", 
        RowBox[{"First", "@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"FileNames", "[", 
            RowBox[{"\"\<*\>\"", ",", " ", "tmpDir"}], "]"}], ",", " ", 
           "DirectoryQ"}], "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"documentationDir", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"pacletRootDir", ",", " ", "\"\<Documentation\>\""}], "}"}],
          "]"}]}], ";", "\n", "  ", 
       RowBox[{"indexDirs", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"DirectoryQ", "[", "documentationDir", "]"}], ",", " ", 
          RowBox[{"DeleteDuplicates", "@", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"FileNames", "[", 
                
                RowBox[{"\"\<Index\>\"", ",", " ", "documentationDir", ",", 
                 " ", "Infinity"}], "]"}], ",", " ", 
               RowBox[{"FileNames", "[", 
                
                RowBox[{"\"\<SearchIndex\>\"", ",", " ", "documentationDir", ",",
                  " ", "Infinity"}], "]"}], ",", " ", 
               RowBox[{"FileNames", "[", 
                
                RowBox[{"\"\<SpellIndex\>\"", ",", " ", "documentationDir", ",",
                  " ", "Infinity"}], "]"}]}], "]"}], ",", " ", "DirectoryQ"}],
             "]"}]}], ",", " ", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"DeleteDirectory", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"DeleteContents", " ", "->", " ", "True"}]}], "]"}], " ", 
          "&"}], ",", " ", "indexDirs"}], "]"}], ";", "\n", "  ", 
       RowBox[{"kernelDir", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"pacletRootDir", ",", " ", "\"\<Kernel\>\""}], "}"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "kernelDir", "]"}]}], ",", " ", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"kernelDir", ",", " ", 
           RowBox[{
           "CreateIntermediateDirectories", " ", "->", " ", "True"}]}], 
          "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"initFile", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"kernelDir", ",", " ", "\"\<init.m\>\""}], "}"}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"Export", "[", 
        RowBox[{
        "initFile", ",", 
         " ", "\"\<(* Auto-generated by Scripts/PacletizeResources.nb \
*)\\nGet[FileNameJoin[{DirectoryName[$InputFileName], \\\"..\\\", \
\\\"PacletizedResourceFunctions.wl\\\"}]]\\n\>\"", ",", 
         " ", "\"\<String\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"CreateArchive", "[", 
        RowBox[{"pacletRootDir", ",", " ", "file", ",", " ", 
         RowBox[{"OverwriteTarget", " ", "->", " ", "True"}]}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"DeleteDirectory", "[", 
        RowBox[{"tmpDir", ",", " ", 
         RowBox[{"DeleteContents", " ", "->", " ", "True"}]}], "]"}], ";", 
       "\n", "  ", "file"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"stripPacletSearchIndices", "[", "fileName", "]"}], ";"}]}], "Input",\

