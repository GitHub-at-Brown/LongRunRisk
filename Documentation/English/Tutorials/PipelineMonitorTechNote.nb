Notebook[{

Cell[CellGroupData[{
Cell["Pipeline Monitor for Model Management", "Title",
 CellID->509267359,ExpressionUUID->"f2514675-c067-4391-b738-12aebcbb80f4"],

Cell["\<\
The Pipeline Monitor helps users manage economic models in the LongRunRisk \
paclet by detecting catalog changes, validating model configurations, and \
orchestrating the build pipeline. It provides both an interactive interface \
in notebooks and a command-line interface for terminal users.\
\>", "Text",
 CellID->1534169418,ExpressionUUID->"1d60b798-7bb7-4629-bafd-949dbb0b8076"],

Cell[CellGroupData[{

Cell["Load the LongRunRisk package:", "MathCaption",
 CellID->1825449234,ExpressionUUID->"60bf169c-eb5a-4068-ba9b-7f34a14326d4"],

Cell[BoxData[
 RowBox[{"<<", "FernandoDuarte`LongRunRisk`"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1373894796,ExpressionUUID->"950cd364-b6dd-4a42-8b39-70917157a4a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Checking for Catalog Changes", "Section",
 CellID->2591,ExpressionUUID->"cbb4111d-e939-49c0-a4fc-b9e76fa68484"],

Cell["\<\
After editing the model catalog, use CheckModels to detect changes and \
validate configurations. The function automatically identifies new, changed, \
and removed models, then displays a pipeline status report.\
\>", "Text",
 CellID->16706,ExpressionUUID->"3142a608-c419-4058-88e8-5b89521eabd3"],

Cell[BoxData[GridBox[{
   {
    RowBox[{"CheckModels", "[", "]"}], Cell["\<\
check the catalog for changes and offer to build updated models\
\>", "TableText",ExpressionUUID->"b1db1ab4-991f-4cf9-914b-5596e28fdfd2"]}
  }]], "DefinitionBox",
 CellID->19362,ExpressionUUID->"cd4db743-f4e0-4f59-9b6f-2f17e3f1edf6"],

Cell["Checking for catalog changes.", "Caption",
 CellID->19031,ExpressionUUID->"8587fe24-fc76-459d-a403-720856ccdc67"],

Cell[CellGroupData[{

Cell["Check for catalog changes and view pipeline status:", "MathCaption",
 CellID->6421,ExpressionUUID->"a38fefd9-86b5-4be8-83ec-76f13d037f82"],

Cell[BoxData[
 RowBox[{"CheckModels", "[", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->27111,ExpressionUUID->"aa4d12d7-235d-46fa-87f7-552b4e202665"]
}, Open  ]],

Cell["\<\
If working on the front end in a notebook, a dialog appears showing changed \
models and their pipeline status. If working on a terminal, an ASCII table is \
printed with the command needed to build the models.\
\>", "Text",
 CellChangeTimes->{{3.9746857304050627`*^9, 3.974685781283971*^9}},
 CellID->16707,ExpressionUUID->"e85aa1f2-a307-47d1-b1e0-793b74de89d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Working with Models", "Section",
 CellID->30767,ExpressionUUID->"70986d04-08c4-4c2c-8f5e-7f0abe49575d"],

Cell["\<\
Models are defined in Catalog.wl located at Kernel/Model/Catalog.wl. Each \
model is an entry in the models association with required fields: name, \
shortname, enabled, stateVars, and parameters.\
\>", "Text",
 CellID->3951,ExpressionUUID->"f6a06541-090b-4e7a-9fb5-18160498857d"],

Cell[CellGroupData[{

Cell["Model Entry Structure", "Subsection",
 CellID->30768,ExpressionUUID->"d55e0654-4313-4db2-820d-ee9e9ad594be"],

Cell[BoxData[GridBox[{
   {Cell["Field", "TableHeader",ExpressionUUID->
     "2375f09b-dc48-49e9-8b62-07ffe4a636b6"], Cell[
    "Required", "TableHeader",ExpressionUUID->
     "83770526-c76f-4688-95e3-091ebd4b4e86"], Cell[
    "Description", "TableHeader",ExpressionUUID->
     "e6db2807-403e-4d50-88f6-2d2c8dddf7bd"]},
   {"\"\<name\>\"", "Yes", Cell[
    "Human-readable model name", "TableText",ExpressionUUID->
     "3a7abcd8-6a6a-41fd-a325-2e64bd89c597"]},
   {"\"\<shortname\>\"", "Yes", Cell[
    "Short identifier used in file names (e.g., \"BY\")", "TableText",
     ExpressionUUID->"8a1f2ae9-2143-4215-a1b5-0e6c0a3983a4"]},
   {"\"\<enabled\>\"", "Yes", Cell[
    "Boolean; set True to include in builds", "TableText",ExpressionUUID->
     "4c98e15f-b32b-4a97-a34d-ed82a344fb46"]},
   {"\"\<stateVars\>\"", "Yes", Cell[
    "List of state variables as symbols with time argument", "TableText",
     ExpressionUUID->"841af54f-b2a5-47e9-a2cb-63c1b6840958"]},
   {"\"\<parameters\>\"", "Yes", Cell[
    "List of parameter rules with numerical values", "TableText",
     ExpressionUUID->"42cdcb3b-0980-49c6-b6b7-7b9bdc176a43"]},
   {"\"\<bibRef\>\"", "No", Cell[
    "Bibliography reference key", "TableText",ExpressionUUID->
     "fa493aa2-dd57-48f5-beb7-df5d104b2c88"]},
   {"\"\<desc\>\"", "No", Cell[
    "Extended description text", "TableText",ExpressionUUID->
     "13c02eed-3aa7-4e94-b0e4-64542968f243"]}
  },
  GridBoxDividers->{
   "Rows" -> {False, True, {False}, False}}]], "DefinitionBox3Col",
 CellID->2017,ExpressionUUID->"434f2908-05ec-460b-9707-58b38ab20856"],

Cell["Required and optional fields for model entries.", "Caption",
 CellID->21763,ExpressionUUID->"0413904d-c967-41fb-b814-6f8aee102826"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Adding a New Model", "Subsection",
 CellID->30769,ExpressionUUID->"ea819038-30a9-4d53-a860-8139f2c61fb0"],

Cell["\<\
To add a new model, insert a new entry in the models association in \
Catalog.wl. The entry key should be a unique string identifier.\
\>", "Text",
 CellID->3952,ExpressionUUID->"7f150b3a-12a7-4b4a-ab1d-aa24c9c7b2ea"],

Cell[CellGroupData[{

Cell["Example model entry structure:", "MathCaption",
 CellID->6422,ExpressionUUID->"5b0acb16-59a6-4780-845b-a03c7618e5d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Add", " ", "to", " ", 
     RowBox[{"Catalog", ".", "wl"}], " ", "inside", " ", "models"}], " ", "=",
     " ", 
    RowBox[{"<|", " ", "...", " ", "|>"}]}], " ", "*)"}], "\n", 
  RowBox[{"\"\<MyNewModel\>\"", " ", "->", " ", 
   RowBox[{"<|", "\n", "    ", 
    RowBox[{
     RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<My Custom Model\>\""}], ",",
      "\n", "    ", 
     RowBox[{"\"\<shortname\>\"", " ", "->", " ", "\"\<MNM\>\""}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<enabled\>\"", " ", "->", " ", "True"}], ",", "\n", "    ", 
     RowBox[{"\"\<stateVars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"x", "[", "t", "]"}], ",", " ", 
       RowBox[{"sx", "[", "t", "]"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<parameters\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"delta", " ", "->", " ", "0.998"}], ",", "\n", "        ", 
        RowBox[{"psi", " ", "->", " ", "1.5"}], ",", "\n", "        ", 
        RowBox[{"gamma", " ", "->", " ", "10"}]}], "\n", "    ", "}"}]}]}], 
    "\n", "|>"}]}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->27112,ExpressionUUID->"46127351-4bef-44eb-b626-4ea4ca10b8f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["After adding the model, save and check for changes:", "MathCaption",
 CellChangeTimes->{{3.97468586998629*^9, 3.974685873848729*^9}},
 CellID->6423,ExpressionUUID->"4fee8a67-f64b-4b4b-bb44-9364c088fa05"],

Cell[BoxData[
 RowBox[{"CheckModels", "[", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->27113,ExpressionUUID->"7703aad1-59d4-46a5-a346-c15dbefc06a9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Updating an Existing Model", "Subsection",
 CellID->30770,ExpressionUUID->"6211bab4-96e2-4f32-8a7b-80f150456f10"],

Cell["\<\
To modify an existing model, edit its entry in Catalog.wl. Common changes \
include adjusting parameter values or modifying the state variable list.\
\>", "Text",
 CellID->3953,ExpressionUUID->"a050fe11-2cc2-4d9a-b622-78dbd88a2fcc"],

Cell[CellGroupData[{

Cell["\<\
For example, to change the risk aversion parameter gamma in the BY model:\
\>", "MathCaption",
 CellID->6424,ExpressionUUID->"d4a37bc2-6e6e-4219-9efe-52565bdfc244"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", 
     RowBox[{"Catalog", ".", "wl"}]}], ",", " ", 
    RowBox[{"find", " ", "the", " ", "\"\<BY\>\"", " ", "entry", " ", "and", " ", 
     RowBox[{"modify", ":"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"gamma", " ", "->", " ", "12", "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"changed", " ", "from", " ", "10"}], " ", "*)"}]}]}]], "Input",
 CellLabel->"In[5]:=",
 CellID->27114,ExpressionUUID->"34019732-d270-45f3-b564-625ca66350fd"]
}, Open  ]],

Cell["\<\
Model parameters are the default parameters. Users can use models with any \
set of parameters after they are built.\
\>", "Text",
 CellChangeTimes->{{3.974685912063202*^9, 3.9746860172786694`*^9}, {
  3.9746860563484087`*^9, 3.974686061301602*^9}},
 CellID->1487916350,ExpressionUUID->"b0f56b78-635c-4a29-b8a7-10e96575cd15"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Disabling a Model", "Subsection",
 CellID->30771,ExpressionUUID->"5b021ae6-8504-4157-a043-d15426b27200"],

Cell["\<\
To temporarily exclude a model from builds without removing it, set the \
enabled field to False.\
\>", "Text",
 CellID->3954,ExpressionUUID->"85843cba-ba62-42d0-ab27-0aac5d2f31c0"],

Cell[CellGroupData[{

Cell["Disable a model by setting enabled to False:", "MathCaption",
 CellID->6425,ExpressionUUID->"00f59cf8-fb22-473d-acf4-0e5692e5817a"],

Cell[BoxData[
 RowBox[{"\"\<BYlowPers\>\"", " ", "->", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<name\>\"", " ", "->", 
     " ", "\"\<Long-run risk with low persistence\>\""}], ",", "\n", "    ", 
    RowBox[{"\"\<shortname\>\"", " ", "->", " ", "\"\<BYlowPers\>\""}], ",", 
    "\n", "    ", 
    RowBox[{"\"\<enabled\>\"", " ", "->", " ", "False"}], ","}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Model", " ", "will", " ", "be", " ", "skipped", " ", "during", " ", 
     "builds"}], " ", "*)"}], "\n", "    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"...", " ", "rest", " ", "of", " ", "specification"}], " ", 
     "..."}], " ", "*)"}], "\n", "|>"}]}]], "Input",
 CellLabel->"In[6]:=",
 CellID->27115,ExpressionUUID->"41fdb6fb-66f0-4d6c-a065-4a29ea86ea67"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Removing a Model", "Subsection",
 CellID->30772,ExpressionUUID->"eb39fcfb-ab3d-4ba0-9497-4e6631da74fe"],

Cell["\<\
To permanently remove a model, delete its entire entry from the models \
association in Catalog.wl. The next call to CheckModels will detect the \
removal.\
\>", "Text",
 CellID->3955,ExpressionUUID->"aa138a1c-5993-4ea7-a5d6-2f9652ee2031"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Pipeline Stages", "Section",
 CellID->32197,ExpressionUUID->"addeafa6-f8e5-419f-9d20-5c88bb46bc4f"],

Cell["\<\
The build pipeline processes models through four sequential stages. Each \
stage must complete successfully before the next begins.\
\>", "Text",
 CellID->19192,ExpressionUUID->"277b3b03-d04a-4192-b1fc-535a91d3f54e"],

Cell[BoxData[GridBox[{
   {Cell["Stage", "TableHeader",ExpressionUUID->
     "30026068-2c49-4f14-b92f-611ee84ed4ab"], Cell[
    "Description", "TableHeader",ExpressionUUID->
     "3a242b59-cafd-4241-b6dd-2397f72c41ea"], Cell[
    "Output", "TableHeader",ExpressionUUID->
     "812b3e16-2ca9-470a-9725-f6a18c231490"]},
   {"Symbolic", Cell[
    "Solve model symbolically", "TableText",ExpressionUUID->
     "7b612b52-66cb-4685-be1b-6dac8a0c378a"], Cell[
    "Closed-form solutions, moments of state variables", "TableText",
     ExpressionUUID->"28a79f85-43d0-491f-b16d-892dd0dbf5ae"]},
   {"Compile", Cell[
    "Compile functions for numerical evaluation", "TableText",ExpressionUUID->
     "9ddd684f-106b-41ff-9562-8c567fbebe86"], Cell[
    ".mx files in CompiledFunctions/", "TableText",ExpressionUUID->
     "11521e5f-8672-4566-8904-535a926297c8"]},
   {"Numerical", Cell[
    "Solve model numerically", "TableText",ExpressionUUID->
     "661a5628-7f89-44cd-8d33-ba8815e0e957"], Cell[
    "Numerical solution when closed-form unavailable", "TableText",
     ExpressionUUID->"63a4a085-e3f9-477e-b674-b943e0b009e5"]},
	   {"Moments", Cell[
	    "Compute moments lookup tables", "TableText",ExpressionUUID->
	     "fd19b413-5fc9-4d3d-82a8-203ef5f28934"], Cell[
	    ".mx files in MomentsLookupTables/", "TableText",ExpressionUUID->
	     "b735a34c-de97-46f9-8349-da27aa984eb4"]}
	  },
	  GridBoxDividers->{
	   "Rows" -> {False, True, {False}, False}}]], "DefinitionBox3Col",
 CellChangeTimes->{{3.974686118855688*^9, 3.97468619626602*^9}, {
  3.974686248377439*^9, 3.9746863800454493`*^9}, {3.974686417173634*^9, 
  3.974686427019957*^9}, {3.974686457771183*^9, 3.974686490154859*^9}, {
  3.974686528360814*^9, 3.97468666594198*^9}},
 CellID->3225,ExpressionUUID->"23f7e856-40d5-4a9f-b0ca-b5f2d8c00d72"],

Cell["Pipeline stages and their outputs.", "Caption",
 CellID->16825,ExpressionUUID->"5f026f32-88ae-405b-9798-2346d7e45387"],

Cell["\<\
The CheckModels function displays the current pipeline status for each model. \
A checkmark indicates a completed stage, an arrow indicates the next stage to \
run, and a circle indicates a pending stage.\
\>", "Text",
 CellID->25290,ExpressionUUID->"827fad0c-f8d1-46ec-86ef-d7afb17f7375"],

Cell[CellGroupData[{

Cell["Example terminal output showing pipeline status:", "MathCaption",
 CellID->26053,ExpressionUUID->"6c8668e9-babf-4ddc-8f6a-135dba079468"],

Cell["\<\
| Model     | Sym  | Comp | Num  | Mom  | Next       | Reason    |
|-----------|------|------|------|------|------------|----------|
| BY        | [OK] | [>>] | [ ]  | [ ]  | Compile    | hash mism |
| NRC       | [OK] | [OK] | [OK] | [>>] | Moments    | stale     |\
\>", "Code",
 CellID->19391,ExpressionUUID->"8f82a169-48a3-4685-80a6-f515cce19c52"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Building Models", "Section",
 CellID->32198,ExpressionUUID->"ae7afef4-e41d-4f3d-a121-9dfbe5c625eb"],

Cell["\<\
After reviewing the pipeline status, build the models using BuildModels. If \
working on a Front End notebook, the CheckModels dialog provides a \"Build \
Now\" button. In terminal mode, the exact command to run that builds models \
is displayed on screen.\
\>", "Text",
 CellChangeTimes->{{3.974686702300865*^9, 3.974686809999498*^9}},
 CellID->19193,ExpressionUUID->"84f45800-99f6-41cd-bef8-8e503f2f6396"],

Cell[BoxData[GridBox[{
   {
    RowBox[{"BuildModels", "[", 
     RowBox[{"\"\<Models\>\"", "->", 
      RowBox[{"{", "shortnames", "}"}]}], "]"}], Cell[
    "build specified models through all pipeline stages", "TableText",
     ExpressionUUID->"337495a8-9f2d-490b-8413-af1020b1bd1f"]},
   {
    RowBox[{"BuildModels", "[", "]"}], Cell[
    "build all enabled models", "TableText",ExpressionUUID->
     "a8da975a-5b4a-42bf-832a-d927fbdbcfd1"]}
  }]], "DefinitionBox",
 CellChangeTimes->{{3.974686822387224*^9, 3.974686823920371*^9}},
 CellID->19045,ExpressionUUID->"c782353b-d600-467b-b77d-fe9a0add0835"],

Cell["Building models with BuildModels.", "Caption",
 CellChangeTimes->{3.974686829168398*^9},
 CellID->7357,ExpressionUUID->"c675c8d3-d865-4958-a85b-f948dd54735b"],

Cell[CellGroupData[{

Cell["Build specific models:", "MathCaption",
 CellChangeTimes->{3.974686867897655*^9},
 CellID->27664,ExpressionUUID->"e4d7b0e1-9569-4d8c-8574-588d43da38d1"],

Cell[BoxData[
 RowBox[{"BuildModels", "[", 
  RowBox[{"\"\<Models\>\"", "->", 
   RowBox[{"{", 
    RowBox[{"\"\<BY\>\"", ",", "\"\<NRC\>\""}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9746868705706472`*^9, 3.9746868708721037`*^9}},
 CellLabel->"In[7]:=",
 CellID->6364,ExpressionUUID->"add44856-b172-45f4-a917-05ab197e3087"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Build all enabled models:", "MathCaption",
 CellID->6827,ExpressionUUID->"c8622fdc-9a9e-4fdb-8ff6-1118024de1ce"],

Cell[BoxData[
 RowBox[{"BuildModels", "[", "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->17078,ExpressionUUID->"f52c929d-9098-41b1-a9d2-52c918ce986d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Configuration Options", "Section",
 CellID->32199,ExpressionUUID->"1fd3bffb-93a0-4acf-942f-276c7e0ce26e"],

Cell["\<\
The Pipeline Monitor can be configured via a configuration file located in \
your Wolfram user base directory: \
$UserBaseDirectory/ApplicationData/FernandoDuarte/LongRunRisk/config.wl. \
Create this directory and file to customize behavior.\
\>", "Text",
 CellID->19194,ExpressionUUID->"830527be-ef00-4509-b5c5-cd706da3c27b"],

Cell[BoxData[GridBox[{
   {Cell["Option", "TableHeader",ExpressionUUID->
     "a1b2c3d4-e5f6-7890-abcd-ef1234567890"], Cell[
    "Description", "TableHeader",ExpressionUUID->
     "b2c3d4e5-f678-9012-bcde-f23456789012"]},
   {"\"\<PipelineMonitorEnabled\>\"", Cell[
    "Boolean; controls whether CheckModels runs automatically on package load \
(default True)", "TableText",ExpressionUUID->
     "c3d4e5f6-7890-1234-cdef-345678901234"]}
  },
  GridBoxDividers->{
   "Rows" -> {False, True, {False}, False}}]], "DefinitionBox",
 CellID->19363,ExpressionUUID->"d4e5f6a7-8901-2345-def0-456789012345"],

Cell["Available configuration options.", "Caption",
 CellID->19032,ExpressionUUID->"e5f6a7b8-9012-3456-ef01-567890123456"],

Cell[TextData[{
 "Open or create your configuration file: ",
 StyleBox[ButtonBox["$UserBaseDirectory/ApplicationData/FernandoDuarte/\
LongRunRisk/config.wl",
  Appearance->None,
  Evaluator->Automatic,
  Method->"Queued",
  ButtonFunction:>(Needs["FernandoDuarte`LongRunRisk`Tools`PipelineMonitor`"]; 
   FernandoDuarte`LongRunRisk`Tools`PipelineMonitor`Private`\
openOrCreateConfigFile[])],
  StripOnInput->False,
  FontVariations->{"Underline"->True},
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellID->418277356,ExpressionUUID->"a7dcfeb0-b61e-459e-b128-1164f8d0be83"],

Cell[CellGroupData[{

Cell["Disabling Auto-Check", "Subsection",
 CellID->30773,ExpressionUUID->"16bce7ee-3ecc-49d1-8a49-5f6f454597e0"],

Cell["\<\
By default, CheckModels runs automatically when the package first loads. To \
disable this auto-check, set PipelineMonitorEnabled to False in the \
configuration file.\
\>", "Text",
 CellID->3956,ExpressionUUID->"4ca0521d-7907-45e0-b877-c07be15aca95"],

Cell[CellGroupData[{

Cell["\<\
Create or edit the config file in your Wolfram user base directory \
(ApplicationData/FernandoDuarte/LongRunRisk/config.wl):\
\>", "MathCaption",
 CellID->6426,ExpressionUUID->"16c21ac6-1648-4a91-81ce-6f151bd267ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Contents", " ", "of", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"$UserBaseDirectory", "/", "ApplicationData"}], "/", 
       "FernandoDuarte"}], "/", "LongRunRisk"}], "/", 
     RowBox[{"config", ".", "wl"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{"\"\<PipelineMonitorEnabled\>\"", " ", "->", " ", "False"}], "\n", 
   "|>"}]}]], "Input",
 CellLabel->"In[9]:=",
 CellID->27116,ExpressionUUID->"ad4f3331-b94e-4024-99b6-fd1759d37738"]
}, Open  ]],

Cell["\<\
With auto-check disabled, explicitly call CheckModels when needed.\
\>", "Text",
 CellID->3957,ExpressionUUID->"97714787-5c13-472c-942f-600631da8387"]
}, Open  ]]
}, Open  ]],

