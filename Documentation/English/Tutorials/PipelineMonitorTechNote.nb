Cell[CellGroupData[{

Cell["Metadata", "MetadataSection",
 CellID->311882160,ExpressionUUID->"6bb9261e-8c4f-409e-ae5f-34e9db317130"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection",
 CellID->1122911449,ExpressionUUID->"1b302534-c4a7-4b1c-8125-647a6fddfcd0"],

