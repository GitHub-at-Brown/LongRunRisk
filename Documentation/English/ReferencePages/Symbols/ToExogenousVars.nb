Notebook[{

Cell[CellGroupData[{
Cell["ToExogenousVars", "ObjectName",
 CellID->866472157,ExpressionUUID->"88bc237b-36d0-4f45-bdc1-6119f5effb6d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ef7c48a7-3c1c-42b8-a530-3d5616e684f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToExogenousVars",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToExogenousVars"], "[", 
   
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fac3e7d5-e48e-4488-a00f-765817817937"],
 "\[LineSeparator]gives a pure (or \"anonymous\") function that re-writes its \
argument in terms of the exogenous variables of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "9463776f-469f-4f7e-8bd1-803370a48541"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"caca0581-c2a2-4f09-8f6b-874e885ea015"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToExogenousVars",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToExogenousVars"], "[", 
   
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "21663eb0-24d6-46f2-8b0e-4931cc9a841e"],
 "\[LineSeparator]re-writes its first argument in terms of the exogenous \
variables of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "df84c287-4f57-42f6-9346-7d3bc17cf630"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058281536669*^9, 3.971058281596189*^9}},
 CellID->710932392,ExpressionUUID->"586b8ff6-119e-44ad-9e4d-fa5abd046f1e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToExogenousVars",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToExogenousVars"]], 
  "InlineFormula",ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 " expands expressions by substituting endogenous variable definitions, \
stopping before applying exogenous variable equations."
}], "Notes",
 CellID->41700436,ExpressionUUID->"8763948d-4c3f-46e6-b79e-6a165ffaf8de"],

Cell[TextData[{
 "The result expresses quantities in terms of the exogenous variables (such \
as ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",ExpressionUUID->
  "b1c2d3e4-f5a6-7890-bcde-f12345678901"],
 " and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Sigma]", "x"}], "TI"]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-cdef-123456789012"],
 ") without expanding them further into lags and shocks."
}], "Notes",
 CellID->912345678,ExpressionUUID->"d3e4f5a6-b7c8-9012-def1-234567890123"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  ButtonBox["ToEquation",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"]], 
  "InlineFormula",ExpressionUUID->"e4f5a6b7-c8d9-0123-ef12-345678901234"],
 ", ",
 Cell[BoxData[
  ButtonBox["ToExogenousVars",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToExogenousVars"]], 
  "InlineFormula",ExpressionUUID->"f5a6b7c8-d9e0-1234-f123-456789012345"],
 " does not expand exogenous variables into their lags and shocks."
}], "Notes",
 CellID->123456789,ExpressionUUID->"a6b7c8d9-e0f1-2345-1234-567890123456"]
}, Open  ]],

