 Cell[BoxData[
  RowBox[{
   ButtonBox["YieldCurve",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/YieldCurve"], "[",
   RowBox[{
    StyleBox["model", "TI"], ",",
    StyleBox["newParameters", "TI"], ",",
    StyleBox["coeffsWc", "TI"], ",",
    StyleBox["bondType", "TI"], ",",
    StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8f0e1157-a3d3-4686-9e39-8d0007d8bb27"],
 "\[LineSeparator]computes and plots bond yields as a function of maturity."
}], "Usage",
