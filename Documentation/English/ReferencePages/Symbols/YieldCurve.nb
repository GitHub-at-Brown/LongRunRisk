 Cell[BoxData[
  StyleBox["bondType", "TI"]], "InlineFormula",ExpressionUUID->
  "60c9bf06-951b-443d-aa83-9e971ddcf135"],
 " specifies whether to compute nominal bond yields (\"nombond\") or real \
bond yields (\"bond\")."
}], "Notes",
 CellID->1904703016,ExpressionUUID->"60c9bf06-951b-443d-aa83-9e971ddcf135"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["newParameters", "TI"]], "InlineFormula",ExpressionUUID->
  "61c9bf06-951b-443d-aa83-9e971ddcf136"],
 " allows overriding model parameters for the yield curve calculation."
}], "Notes",
 CellID->1904703018,ExpressionUUID->"61c9bf06-951b-443d-aa83-9e971ddcf136"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["coeffsWc", "TI"]], "InlineFormula",ExpressionUUID->
  "62c9bf06-951b-443d-aa83-9e971ddcf137"],
 " contains the wealth-consumption ratio coefficients for the model."
}], "Notes",
 CellID->1904703019,ExpressionUUID->"62c9bf06-951b-443d-aa83-9e971ddcf137"],

