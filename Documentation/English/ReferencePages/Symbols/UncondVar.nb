Notebook[{

Cell[CellGroupData[{
Cell["UncondVar", "ObjectName",
 CellID->2094397850,ExpressionUUID->"e39f7833-760b-4628-9564-de57fc2a8323"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1b9039df-05ec-4308-a3fa-20d3607e7192"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UncondVar",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondVar"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "37863eb2-e17f-445e-9a19-451e8ac9d0ca"],
 "\[LineSeparator]gives the unconditional variance of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "c7f858fc-2ab8-463e-99fb-cf9ca80749d3"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "13239eb0-0aa5-48bc-ab0e-06e8d833b47d"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058283427527*^9, 3.971058283458519*^9}, {3.9716*^9, 
  3.9716001*^9}},
 CellID->1140206973,ExpressionUUID->"20e1328e-c3e4-42fe-be4c-a98849aae91b"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondVar",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondVar"]], 
  "InlineFormula",ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff62f"],
 " is computed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"UncondE", "[", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"expr", "-", 
       RowBox[{"UncondE", "[", 
        RowBox[{"expr", ",", "model"}], "]"}]}], ")"}], "2"], "]"}], 
   TraditionalForm]],ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff630"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9716002*^9, 3.97160025*^9}},
 CellID->1462013030,ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff631"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondVar",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondVar"]], 
  "InlineFormula",ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff632"],
 " computes variance with respect to the stationary distribution of the model."
}], "Notes",
 CellChangeTimes->{{3.9716003*^9, 3.97160035*^9}},
 CellID->1462013031,ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff633"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  ButtonBox["Var",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Var"]], "InlineFormula",
  ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff634"],
 ", ",
 Cell[BoxData[
  ButtonBox["UncondVar",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondVar"]], 
  "InlineFormula",ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff635"],
 " does not condition on information at a specific time and does not require \
a time parameter."
}], "Notes",
 CellChangeTimes->{{3.9716004*^9, 3.97160045*^9}},
 CellID->1462013032,ExpressionUUID->"3151946b-8113-42c9-807d-0066fa9ff636"]
}, Open  ]],

