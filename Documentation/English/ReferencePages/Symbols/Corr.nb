Notebook[{

Cell[CellGroupData[{
Cell["Corr", "ObjectName",
 CellID->935924007,ExpressionUUID->"49dfe77f-c614-4864-beaa-412ef4075103"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"59d78911-3c35-40ee-af5a-0c896cbc13ec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Corr",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Corr"], "[", 
   RowBox[{
    StyleBox["expr1", "TI"], ",", 
    StyleBox["expr2", "TI"], ",", 
    StyleBox["s", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "515779fd-b8bb-4172-9f4b-0a9aef9434e3"],
 "\[LineSeparator]gives the conditional correlation between ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "f5fe9738-4aab-456e-b7c3-6116a7abb90a"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "f5fe9738-4aab-456e-b7c3-6116a7abb90b"],
 " given information at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "f5fe9738-4aab-456e-b7c3-6116a7abb90c"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "f5fe9738-4aab-456e-b7c3-6116a7abb90d"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058278737721*^9, 3.9710584853765707`*^9}, {
  3.97158*^9, 3.9715801*^9}},
 CellID->1904555021,ExpressionUUID->"2b84da10-1aae-4348-a554-13efd30f1f0d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Corr",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Corr"]], 
  "InlineFormula",ExpressionUUID->"43503892-7f22-4146-83fb-acc2a3851986"],
 " is computed as ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"Cov", "[", 
     RowBox[{"expr1", ",", "expr2", ",", "s", ",", "model"}], "]"}], 
    RowBox[{
     SqrtBox[
      RowBox[{"Var", "[", 
       RowBox[{"expr1", ",", "s", ",", "model"}], "]"}]], 
     SqrtBox[
      RowBox[{"Var", "[", 
       RowBox[{"expr2", ",", "s", ",", "model"}], "]"}]]}]], 
   TraditionalForm]],ExpressionUUID->"43503892-7f22-4146-83fb-acc2a3851987"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9715802*^9, 3.97158025*^9}},
 CellID->1612479412,ExpressionUUID->"43503892-7f22-4146-83fb-acc2a3851988"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Corr",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Corr"]], 
  "InlineFormula",ExpressionUUID->"43503892-7f22-4146-83fb-acc2a3851989"],
 " has attribute ",
 Cell[BoxData[
  ButtonBox["HoldFirst",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a385198a"],
 " to prevent premature evaluation of the expressions."
}], "Notes",
 CellChangeTimes->{{3.9715803*^9, 3.97158035*^9}},
 CellID->1612479413,ExpressionUUID->"43503892-7f22-4146-83fb-acc2a385198b"],

Cell[TextData[{
 "The conditional correlation ranges between -1 and 1, measuring the linear \
relationship between ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a385198c"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a385198d"],
 " given information at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a385198e"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9715804*^9, 3.97158045*^9}},
 CellID->1612479414,ExpressionUUID->"43503892-7f22-4146-83fb-acc2a385198f"],

Cell[TextData[{
 "The correlation is well-defined only when both ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a3851990"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "43503892-7f22-4146-83fb-acc2a3851991"],
 " have non-zero conditional variances."
}], "Notes",
 CellChangeTimes->{{3.9715804*^9, 3.97158045*^9}},
 CellID->1612479415,ExpressionUUID->"43503892-7f22-4146-83fb-acc2a3851992"]
}, Open  ]],

