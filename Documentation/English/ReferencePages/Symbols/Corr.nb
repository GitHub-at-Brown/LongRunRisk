Cell["\<\
Compute the conditional correlation between consumption growth and dividend \
growth:\
\>", "ExampleText",
 CellChangeTimes->{{3.9715808*^9, 3.97158085*^9}},
 CellID->883962293,ExpressionUUID->"4d99f110-698b-4b0b-ba70-3dad1f4b5044"],

Cell[BoxData[
 RowBox[{"Corr", "[",
  RowBox[{
   RowBox[{"dc", "[",
    RowBox[{"t", "+", "1"}], "]"}], ",",
   RowBox[{"dd", "[",
    RowBox[{
     RowBox[{"t", "+", "1"}], ",", "1"}], "]"}], ",", "t", ",", "model"}],
  "]"}]], "Input",
 CellChangeTimes->{{3.9715809*^9, 3.97158095*^9}},
 CellLabel->"In[1]:=",
 CellID->883962294,ExpressionUUID->"4d99f110-698b-4b0b-ba70-3dad1f4b5045"],

Cell["\<\
Compute the correlation between consumption growth and the spread between \
dividend growth and consumption growth:\
\>", "ExampleText",
 CellChangeTimes->{{3.971581*^9, 3.97158105*^9}, {3.975019902052251*^9,
  3.975019915309228*^9}},
 CellID->883962295,ExpressionUUID->"4d99f110-698b-4b0b-ba70-3dad1f4b5046"],

Cell[BoxData[
 RowBox[{"Corr", "[",
  RowBox[{
   RowBox[{"dc", "[",
    RowBox[{"t", "+", "1"}], "]"}], ",",
   RowBox[{
    RowBox[{"dd", "[",
     RowBox[{
      RowBox[{"t", "+", "1"}], ",", "1"}], "]"}], "-",
    RowBox[{"dc", "[",
     RowBox[{"t", "+", "1"}], "]"}]}], ",", "t", ",", "model"}],
  "]"}]], "Input",
 CellChangeTimes->{{3.9715811*^9, 3.97158115*^9}, {3.9750199208252525`*^9,
  3.9750199227371397`*^9}},
 CellLabel->"In[2]:=",
 CellID->883962296,ExpressionUUID->"4d99f110-698b-4b0b-ba70-3dad1f4b5047"],

Cell["\<\
When both expressions are the same, the correlation equals 1:\
\>", "ExampleText",
 CellChangeTimes->{{3.9715812*^9, 3.97158125*^9}},
 CellID->883962297,ExpressionUUID->"4d99f110-698b-4b0b-ba70-3dad1f4b5048"],

