Cell["\<\
Compute the conditional correlation between consumption growth and its \
long-run component:\
\>", "ExampleText",
 CellID->456789012,ExpressionUUID->"d4e5f6a7-b8c9-0123-4567-890123def456"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Corr", "[", 
  RowBox[{
   RowBox[{"x", "[", 
    RowBox[{"t", "+", "2"}], "]"}], ",", 
   RowBox[{"x", "[", 
    RowBox[{"t", "+", "1"}], "]"}], ",", "t", ",", "model"}], "]"}]], "Input",\

 CellChangeTimes->{{3.971783859883534*^9, 3.9717838711427507`*^9}},
 CellLabel->"In[2]:=",
 CellID->567890123,ExpressionUUID->"e5f6a7b8-c9d0-1234-5678-901234ef5678"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox["Esx", "2"], " ", 
     SuperscriptBox["phix", "2"], " ", "rhox"}], "+", 
    RowBox[{
     SuperscriptBox["phix", "2"], " ", "rhox", " ", 
     RowBox[{"sx", "[", "t", "]"}]}]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{
    SqrtBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["Esx", "2"], " ", 
       SuperscriptBox["phix", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["phix", "2"], " ", 
       RowBox[{"sx", "[", "t", "]"}]}]}]], " ", 
    SqrtBox[
     RowBox[{
      RowBox[{
       SuperscriptBox["Esx", "2"], " ", 
       SuperscriptBox["phix", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["Esx", "2"], " ", 
       SuperscriptBox["phix", "2"], " ", 
       SuperscriptBox["rhox", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["phix", "2"], " ", 
       SuperscriptBox["rhox", "2"], " ", 
       RowBox[{"sx", "[", "t", "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["phix", "2"], " ", "vx", " ", 
       RowBox[{"sx", "[", "t", "]"}]}]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.971741988356801*^9, 3.9717424031132517`*^9, 3.9717456479471292`*^9, 
   3.97174752608497*^9, 3.9717491032148542`*^9, {3.971783850723909*^9, 
   3.9717838716518497`*^9}},
 CellLabel->"Out[2]=",
 CellID->1083772075,ExpressionUUID->"2e48fe38-a047-4871-8bb9-38dbaaca6d50"]
}, Open  ]]
}, Open  ]],

