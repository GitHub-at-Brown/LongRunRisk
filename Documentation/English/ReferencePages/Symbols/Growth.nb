Cell[CellGroupData[{
Cell["Growth", "ObjectName",
 CellID->200000001,ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Growth",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Growth"], "[",
   RowBox[{
    StyleBox["variable", "TI"], ",",
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c1d2e3f4-a5b6-7890-cdef-012345678902"],
 "\[LineSeparator]gives the growth rate at time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "d1e2f3a4-b5c6-7890-def0-123456789abc"],
 " of ",
 Cell[BoxData[
  StyleBox["variable", "TI"]], "InlineFormula",ExpressionUUID->
  "e1f2a3b4-c5d6-7890-ef01-23456789abcd"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1a2b3c4-d5e6-7890-f012-3456789abcde"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Growth",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Growth"], "[",
   RowBox[{
    StyleBox["variable", "TI"], ",",
    StyleBox["t", "TI"], ",",
    StyleBox["i", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a2b3c4d5-e6f7-8901-2345-6789abcdef01"],
 "\[LineSeparator]specifies the stock identifier ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "b2c3d4e5-f6a7-8901-2345-6789abcdef02"],
 " when ",
 Cell[BoxData[
  StyleBox["variable", "TI"]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-2345-6789abcdef03"],
 " is a stock-related variable such as dividends.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d2e3f4a5-b6c7-8901-2345-6789abcdef04"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Growth",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Growth"], "[",
   RowBox[{
    StyleBox["variable", "TI"], ",",
    StyleBox["t", "TI"], ",",
    StyleBox["m", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e2f3a4b5-c6d7-8901-2345-6789abcdef05"],
 "\[LineSeparator]specifies the maturity ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "f2a3b4c5-d6e7-8901-2345-6789abcdef06"],
 " in months when ",
 Cell[BoxData[
  StyleBox["variable", "TI"]], "InlineFormula",ExpressionUUID->
  "a3b4c5d6-e7f8-9012-3456-789abcdef012"],
 " is a bond-related variable such as bond yields."
}], "Usage",
 CellChangeTimes->{{3.9720*^9, 3.9720001*^9}},
 CellID->200000002,ExpressionUUID->"b3c4d5e6-f7a8-9012-3456-789abcdef013"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Growth",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Growth"]],
  "InlineFormula",ExpressionUUID->"c3d4e5f6-a7b8-9012-3456-789abcdef014"],
 " computes time-aggregated growth rates for variables in long-run risk \
models."
}], "Notes",
 CellChangeTimes->{{3.9720002*^9, 3.97200021*^9}},
 CellID->200000003,ExpressionUUID->"d3e4f5a6-b7c8-9012-3456-789abcdef015"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["variable", "TI"]], "InlineFormula",ExpressionUUID->
  "e3f4a5b6-c7d8-9012-3456-789abcdef016"],
 " should be a model variable such as consumption growth (dc), dividend \
growth (dd), or stock returns (rd)."
}], "Notes",
 CellChangeTimes->{{3.9720003*^9, 3.97200031*^9}},
 CellID->200000004,ExpressionUUID->"f3a4b5c6-d7e8-9012-3456-789abcdef017"],

Cell[TextData[{
 "The function uses power series expansion to approximate growth rates of \
flow and ratio variables, controlled by the \"Order\" option."
}], "Notes",
 CellChangeTimes->{{3.9720004*^9, 3.97200041*^9}},
 CellID->200000005,ExpressionUUID->"a4b5c6d7-e8f9-0123-4567-89abcdef0123"],

Cell[TextData[{
 "Common options include ",
 Cell[BoxData[
  ButtonBox["\"TimeAggregation\"",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b4c5d6e7-f8a9-0123-4567-89abcdef0124"],
 " to specify the aggregation period in months, and \"numPeriods\" to \
specify the number of periods over which to compute growth."
}], "Notes",
 CellChangeTimes->{{3.9720005*^9, 3.97200051*^9}},
 CellID->200000006,ExpressionUUID->"c4d5e6f7-a8b9-0123-4567-89abcdef0125"]
}, Open  ]],

