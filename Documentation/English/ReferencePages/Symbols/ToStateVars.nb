Cell[CellGroupData[{
Cell["ToStateVars", "ObjectName",
 CellID->1015006089,ExpressionUUID->"dd5a5fb8-5412-44d8-b040-528d2e751796"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"93a0a7d6-0eb9-4698-a198-00d686669716"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToStateVars",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToStateVars"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "67275793-0725-472c-a51e-847353c19547"],
 "\[LineSeparator]gives a pure (or \"anonymous\") function that re-writes its \
argument in terms of the state variables of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "69a346a3-36fb-4cf6-a5bc-a99c70d59003"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"31eb86de-9d4f-436f-a230-425016ae018c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToStateVars",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToStateVars"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3d14090b-7727-4af4-ae79-86dcb4261d7e"],
 "\[LineSeparator]re-writes ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "1c69325e-da54-4a96-81e6-c1ad681341d2"],
 " in terms of the state variables of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "35ed1718-76ce-4b38-afbe-7fa5fe193c44"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971717129760908*^9, 3.9717171298474073`*^9}},
 CellID->1744729702,ExpressionUUID->"e2e7ce85-9960-4096-b296-88c347e1d3af"],

Cell["\<\
ToStateVars transforms expressions by replacing endogenous and exogenous \
variables with the model's state variables.\
\>", "Notes",
 CellID->1930385376,ExpressionUUID->"c41151e3-3b27-4bf4-acdb-7c001849b4e7"]
}, Open  ]],

