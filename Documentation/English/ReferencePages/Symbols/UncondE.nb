Cell[CellGroupData[{
Cell["UncondE", "ObjectName",
 CellID->1872246985,ExpressionUUID->"b6f7b56d-99d1-455c-a267-5ba9caa8376c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c67d22f9-bf6a-41ad-b3b7-7b3c1c6378a0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UncondE",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondE"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "da0d131d-1605-47e0-b619-201321c1d03d"],
 "\[LineSeparator]gives the unconditional expectation of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "38cb48f1-e707-4f9a-98e9-cac69578323d"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "2393bc20-799c-4bf4-82ea-1a85441e0db2"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058283135379*^9, 3.971058283173318*^9}, {3.97159*^9, 
  3.9715901*^9}},
 CellID->1924681051,ExpressionUUID->"2a645423-f345-4b84-94e7-5adef0dcf902"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondE",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondE"]], 
  "InlineFormula",ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac66d"],
 " computes the expectation with respect to the stationary distribution of \
the model."
}], "Notes",
 CellChangeTimes->{{3.9715902*^9, 3.97159025*^9}},
 CellID->568249396,ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac66e"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  ButtonBox["Ev",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Ev"]], "InlineFormula",
  ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac66f"],
 ", ",
 Cell[BoxData[
  ButtonBox["UncondE",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondE"]], 
  "InlineFormula",ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac670"],
 " does not condition on information at a specific time and does not require \
a time parameter."
}], "Notes",
 CellChangeTimes->{{3.9715903*^9, 3.97159035*^9}},
 CellID->568249397,ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac671"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondE",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondE"]], 
  "InlineFormula",ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac672"],
 " is useful for computing long-run averages and stationary moments of model \
variables."
}], "Notes",
 CellChangeTimes->{{3.9715904*^9, 3.97159045*^9}},
 CellID->568249398,ExpressionUUID->"639abcc5-9ed8-47f5-9394-9bfaa9eac673"]
}, Open  ]],

