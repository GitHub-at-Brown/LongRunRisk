Cell["Solve a simple 2\[Times]2 system:", "ExampleText",
 CellID->203456789,ExpressionUUID->"f0a9b8c7-d6e5-f4a3-b2c1-d0e9f8a7b6c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "-", "5"}], "\[Equal]", "0"}], ",", 
    RowBox[{
     RowBox[{"y", "-", 
      RowBox[{"2", "x"}]}], "\[Equal]", "0"}]}], "}"}]}], "\n", 
 RowBox[{"vars", "=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y"}], "}"}]}], "\n", 
 RowBox[{"result", "=",
  RowBox[{"paramQuadSolve", "[",
   RowBox[{"eqns", ",", "vars"}], "]"}]}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->214567890,ExpressionUUID->"a1b0c9d8-e7f6-a5b4-c3d2-e1f0a9b8c7d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "\[Rule]", 
    RowBox[{
     SqrtBox["5"], " ", 
     RowBox[{"signA", "[", "1", "]"}]}]}], ",", 
   RowBox[{"y", "\[Rule]", 
    RowBox[{"2", " ", 
     SqrtBox["5"], " ", 
     RowBox[{"signA", "[", "1", "]"}]}]}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->225678901,ExpressionUUID->"b2c1d0e9-f8a7-b6c5-d4e3-f2a1b0c9d8e7"]
}, Open  ]],

Cell["Extract the solution:", "ExampleText",
 CellID->236789012,ExpressionUUID->"c3d2e1f0-a9b8-c7d6-e5f4-a3b2c1d0e9f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"result", "[", "\"\<Solution\>\"", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->247890123,ExpressionUUID->"d4e3f2a1-b0c9-d8e7-f6a5-b4c3d2e1f0a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "\[Rule]", 
    RowBox[{
     RowBox[{"signA", "[", "1", "]"}], " ", 
     SqrtBox["5"]}]}], ",", 
   RowBox[{"y", "\[Rule]", 
    RowBox[{"2", " ", 
     RowBox[{"signA", "[", "1", "]"}], " ", 
     SqrtBox["5"]}]}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->258901234,ExpressionUUID->"e5f4a3b2-c1d0-e9f8-a7b6-c5d4e3f2a1b0"]
}, Open  ]],

Cell["Enumerate all solution branches:", "ExampleText",
 CellID->269012345,ExpressionUUID->"f6a5b4c3-d2e1-f0a9-b8c7-d6e5f4a3b2c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"signVars", "=", 
  RowBox[{"Keys", "[", 
   RowBox[{"result", "[", "\"\<SignRootMap\>\"", "]"}], "]"}]}], "\n", 
 RowBox[{"branches", "=", 
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"Length", "[", "signVars", "]"}]}], "]"}]}], "\n", 
 RowBox[{"allSolutions", "=", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"result", "[", "\"\<Solution\>\"", "]"}], "/.", 
     RowBox[{"Thread", "[", 
      RowBox[{"signVars", "\[Rule]", "branch"}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"branch", ",", "branches"}], "}"}]}], "\n", "]"}]}]}], "Input",
 CellLabel->"In[5]:=",
 CellID->270123456,ExpressionUUID->"a7b6c5d4-e3f2-a1b0-c9d8-e7f6a5b4c3d2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"signA", "[", "1", "]"}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->281234567,ExpressionUUID->"b8c7d6e5-f4a3-b2c1-d0e9-f8a7b6c5d4e3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"-", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[6]=",
