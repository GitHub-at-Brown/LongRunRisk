          RowBox[{"signA", "[", "1", "]"}], " ", 
          SqrtBox[
           RowBox[{
            FractionBox["9", "4"], "-", "delta"}]]}], "1"]}]}], "}"}]},
    {
     StyleBox["\<\"Deferred Vars\"\>",
      FontWeight->"Bold"], 
     RowBox[{"{", "}"}], 
