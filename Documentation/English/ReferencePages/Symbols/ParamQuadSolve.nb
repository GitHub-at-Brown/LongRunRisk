Notebook[{

Cell[CellGroupData[{
Cell["paramQuadSolve", "ObjectName",
 CellID->184021964,ExpressionUUID->"6e4ab28a-4c84-4cd9-97a0-d1e11ad56c42"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"90fc7360-bb37-4dd6-b330-f2d6ca89be36"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["paramQuadSolve",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/paramQuadSolve"], "[", 
   
   RowBox[{
    StyleBox["eqns", "TI"], ",", 
    StyleBox["vars", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "62d2dfde-3ef4-4928-9440-96095c571bb4"],
 "\[LineSeparator]solves a square system of polynomial equations where each \
equation is at most quadratic in each variable; bilinear cross-terms are \
permitted because the degree test is per variable.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5363ec5d-d01d-416a-b2c4-b3d1b2419680"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["paramQuadSolve",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/paramQuadSolve"], "[", 
   
   RowBox[{
    StyleBox["eqns", "TI"], ",", 
    StyleBox["vars", "TI"], ",", 
    StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "51699292-4aa5-4c94-89e1-1ad14999e768"],
 "\[LineSeparator]uses the specified options."
}], "Usage",
 CellChangeTimes->{{3.971058281861796*^9, 3.971058282006961*^9}},
 CellID->51215664,ExpressionUUID->"54e04725-50b8-4a3b-97f8-55de39aa5597"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["paramQuadSolve",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/paramQuadSolve"]],
  "InlineFormula",ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 " is a private symbol that returns an Association with keys \"Solution\", \
\"SignRootMap\", \"CoeffMap\", \"Conditions\", \"Assumptions\", \
\"Verification\", \"DeferredVariables\", \"DeferredEquations\", and \
\"Diagnostics\"."
}], "Notes",
 CellID->70234256,ExpressionUUID->"688de85c-019c-4c7e-8d7a-f6b8b20c070c"],

Cell[TextData[{
 "The \"Solution\" key contains replacement rules mapping each variable to a \
parametric expression involving sign variables (e.g., ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["signA",
    BaseStyle->"Link"], "[", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-cdef-123456789012"],
 ")."
}], "Notes",
 CellID->81234567,ExpressionUUID->"d3e4f5a6-b7c8-9012-def1-234567890123"],

Cell["\<\
The \"SignRootMap\" key maps each sign variable to its corresponding square \
root expression.\
\>", "Notes",
 CellID->92345678,ExpressionUUID->"f5a6b7c8-d9e0-1234-f123-456789012345"],

Cell[TextData[{
 "Sign variables can take values ",
 Cell[BoxData[
  RowBox[{"+", "1"}]], "InlineFormula",ExpressionUUID->
  "a7b8c9d0-e1f2-3456-7890-123456789abc"],
 " or ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",ExpressionUUID->
  "b8c9d0e1-f2a3-4567-8901-234567890bcd"],
 ", representing the two branches of each square root."
}], "Notes",
 CellID->103456789,ExpressionUUID->"0ca65932-a04b-428e-b2a0-a2380bd807a4"],

Cell[TextData[{
 "Bilinear cross-terms such as ",
 Cell[BoxData[
  RowBox[{"x", " ", "y"}]], "InlineFormula",ExpressionUUID->
  "3e2e4b4c-d20c-443a-bbbb-771774af846f"],
 " keep each variable's degree at 1, so the solver still treats the system as \
per-variable-quadratic."
}], "Notes",
 CellID->118001234,ExpressionUUID->"deac5c4a-4f9c-4c5a-853d-187fdc0913a2"],

Cell[TextData[{
 "For a system with ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",ExpressionUUID->
  "c9d0e1f2-a3b4-5678-9012-345678901234"],
 " independent radicals, there are ",
 Cell[BoxData[
  SuperscriptBox["2", "N"]], "InlineFormula",ExpressionUUID->
  "d0e1f2a3-b4c5-6789-0123-456789012345"],
 " solution branches."
}], "Notes",
 CellID->114567890,ExpressionUUID->"f5018c7b-43fe-4a65-9bd2-313c5e3d4374"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  ButtonBox["OnlyQuadTerms",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a1b2c3d4-e5f6-7890-abcd-ef1234567891"],
 " \[Rule] ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b2c3d4e5-f6a7-8901-bcde-f1234567892a"],
 ", the solver identifies variables with degree \[GreaterEqual] 2 and solves \
only for those, treating other variables as parameters."
}], "Notes",
 CellID->115678901,ExpressionUUID->"c1d2e3f4-a5b6-c7d8-e9f0-a1b2c3d4e5f6"],

Cell["\<\
The \"DeferredVariables\" and \"DeferredEquations\" keys contain variables \
and equations not included when OnlyQuadTerms is used.\
\>", "Notes",
 CellID->116789012,ExpressionUUID->"d2e3f4a5-b6c7-d8e9-f0a1-b2c3d4e5f6a7"],

Cell["\<\
The \"Verification\" list reports only the equations that were solved. When \
OnlyQuadTerms -> True, deferred equations are not automatically validated.\
\>", "Notes",
 CellID->118101235,ExpressionUUID->"fe5cd0fc-10a5-44e7-9ab3-f1460182123a"],

Cell["\<\
Options accept both short names (Domain, Assumptions, Method, MonomialOrder, \
Validation, Return, Timeout, Diagnostics, OnlyQuadTerms, SignSymbol) and \
their ParamQuadSolver`*Option counterparts.\
\>", "Notes",
 CellID->118889013,ExpressionUUID->"e5cf4b9d-5014-4cba-8d3b-35eab3b11be1"],

Cell["\<\
Method accepts Automatic, \"Sequential\", or \"SequentialWithGroebner\". \
GroebnerBasis is only attempted in the sequential with Groebner mode, and \
MonomialOrder is honored there.\
\>", "Notes",
 CellID->118201236,ExpressionUUID->"48d3c115-7186-4455-88dd-973e4e9a0077"],

Cell["\<\
MonomialOrder can be any order supported by GroebnerBasis (Lexicographic, \
DegreeReverseLexicographic, etc.) and is ignored when Groebner steps are \
disabled.\
\>", "Notes",
 CellID->118301237,ExpressionUUID->"9c7a2b9f-2f62-4b43-9da5-1b11da1f8e1b"],

Cell["\<\
Return -> list projects the final association onto the requested keys, which \
is useful for suppressing the default Diagnostics payload.\
\>", "Notes",
 CellID->118401238,ExpressionUUID->"9d5c2fe7-379e-4ba3-8a67-4477f9d1f0ef"],

Cell["\<\
Timeout bounds the sequential solve in seconds (values <= 0 are rejected); a \
timeout returns <|\"Error\" -> \"Timeout or failure during solving\"|>.\
\>", "Notes",
 CellID->118501239,ExpressionUUID->"8cedf6c5-0444-41dd-9c44-5bb6f928875f"],

Cell["\<\
SignSymbol -> head lets you pick a different symbol for the \[PlusMinus] \
choices; each sign still satisfies sign[k]^2 == 1 and is listed in \
\"SignRootMap\".\
\>", "Notes",
 CellID->118601240,ExpressionUUID->"a501e634-2c31-4f33-8802-9422cbab3146"],

Cell["\<\
Diagnostics -> True/False is currently informational; the solver always \
returns a diagnostics association, but you can omit it via Return -> {...}.\
\>", "Notes",
 CellID->118701241,ExpressionUUID->"c8cec509-793d-4a40-89ed-3b3abe617d40"],

Cell["\<\
Assumptions -> expr is combined with the solver\[CloseCurlyQuote]s default \
economic assumptions; set Assumptions -> True if you need to clear the \
defaults.\
\>", "Notes",
 CellID->118801242,ExpressionUUID->"6d55cf16-d909-4428-b3bc-8a6a3f2dcf24"],

Cell[TextData[{
 "Error messages include ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"paramQuadSolve", "::", "noquad"}],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a1a1b2c3-d4e5-f6a7-b8c9-d0e1f2a3b4c5"],
 " (no quadratic variables detected when OnlyQuadTerms->True) and ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"paramQuadSolve", "::", "nocover"}],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b2b3c4d5-e6f7-a8b9-c0d1-e2f3a4b5c6d7"],
 " (unable to select square subsystem for quadratic variables). Systems that \
fail return ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{"\"\<Error\>\"", "\[Rule]", "\"\<message\>\""}], 
   "\[RightAssociation]"}]], "InlineFormula",ExpressionUUID->
  "c3c4d5e6-f7a8-b9c0-d1e2-f3a4b5c6d7e8"],
 "."
}], "Notes",
 CellID->117890123,ExpressionUUID->"d3e4f5a6-b7c8-d9e0-f1a2-b3c4d5e6f7a8"]
}, Open  ]],

