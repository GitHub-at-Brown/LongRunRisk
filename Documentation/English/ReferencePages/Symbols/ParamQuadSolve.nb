Cell["Compare solving with and without OnlyQuadTerms:", "ExampleText",
 CellID->466889013,ExpressionUUID->"e2f3a4b5-c6d7-e8f9-a0b1-c2d3e4f5a6b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eqns", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["A", "2"], "-", 
      RowBox[{"3", " ", "A"}], "+", "delta"}], "\[Equal]", "0"}], ",", 
    RowBox[{
     RowBox[{"B", "+", 
      RowBox[{"2", " ", "A"}]}], "\[Equal]", "gamma"}]}], "}"}]}], "\n", 
 RowBox[{"vars", "=", 
  RowBox[{"{", 
   RowBox[{"A", ",", "B"}], "}"}]}], "\n", 
 RowBox[{"resultFalse", "=", 
  RowBox[{"paramQuadSolve", "[", 
   RowBox[{"eqns", ",", "vars", ",", 
    RowBox[{"OnlyQuadTerms", "\[Rule]", "False"}]}], "]"}]}], "\n", 
 RowBox[{"resultTrue", "=", 
  RowBox[{"paramQuadSolve", "[", 
   RowBox[{"eqns", ",", "vars", ",", 
    RowBox[{"OnlyQuadTerms", "\[Rule]", "True"}]}], "]"}]}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", 
       StyleBox["\"\<OnlyQuadTerms->False\>\"",
        FontWeight->"Bold"], ",", 
       StyleBox["\"\<OnlyQuadTerms->True\>\"",
        FontWeight->"Bold"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["\"\<Solution\>\"",
        FontWeight->"Bold"], ",", 
       RowBox[{"resultFalse", "[", "\"\<Solution\>\"", "]"}], ",", 
       RowBox[{"resultTrue", "[", "\"\<Solution\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["\"\<Deferred Vars\>\"",
        FontWeight->"Bold"], ",", 
       RowBox[{"resultFalse", "[", "\"\<DeferredVariables\>\"", "]"}], ",", 
       RowBox[{"resultTrue", "[", "\"\<DeferredVariables\>\"", "]"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["\"\<Deferred Eqns\>\"",
        FontWeight->"Bold"], ",", 
       RowBox[{"resultFalse", "[", "\"\<DeferredEquations\>\"", "]"}], ",", 
       RowBox[{"resultTrue", "[", "\"\<DeferredEquations\>\"", "]"}]}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[7]:=",
 CellID->466989014,ExpressionUUID->"e3f4a5b6-c7d8-e9f0-a1b2-c3d4e5f6a7b8"],

Cell[BoxData[
 TagBox[GridBox[{
    {"", 
     StyleBox["\<\"OnlyQuadTerms->False\"\>",
      FontWeight->"Bold"], 
     StyleBox["\<\"OnlyQuadTerms->True\"\>",
      FontWeight->"Bold"]},
    {
     StyleBox["\<\"Solution\"\>",
      FontWeight->"Bold"], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "\[Rule]", 
        RowBox[{
         FractionBox["3", "2"], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"signA", "[", "1", "]"}], " ", 
           SqrtBox[
            RowBox[{
             FractionBox["9", "4"], "-", "delta"}]]}], "1"]}]}], ",", 
