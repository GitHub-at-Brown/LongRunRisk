Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SuperscriptBox["a", "2"], "\[GreaterEqual]", 
    RowBox[{"4", " ", "b"}]}], ",", 
   RowBox[{
    SuperscriptBox["c", "2"], "\[GreaterEqual]", 
    RowBox[{"4", " ", "d"}]}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->478901234,ExpressionUUID->"b8c9d0e1-f2a3-a4b5-c6d7-e8f9a0b1c2d3"]
}, Open  ]],

Cell["\<\
Earlier builds produced Power::infy messages here; the current solver \
simplifies each discriminant check separately, so the output is quiet unless \
you substitute parameter values that violate either inequality.\
\>", "ExampleText",
 CellID->478951235,ExpressionUUID->"c43bb2c1-0c50-4fff-9963-4a8eb7d7a44a"],

Cell["\<\
Real-domain requests for complex roots trigger GreaterEqual::nord:\
\>", "ExampleText",
 CellID->478961236,ExpressionUUID->"298541d4-d601-42b1-8e5a-76d18194f7c0"],

Cell[BoxData[
 RowBox[{"paramQuadSolve", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], "+", "5"}], "\[Equal]", "0"}], ",",
     RowBox[{
      RowBox[{"y", "-", "x"}], "\[Equal]", "0"}]}], "}"}], ",",
   RowBox[{"{",
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->478971237,ExpressionUUID->"73fdc91d-98a6-4b08-9c71-07c566ded040"],

Cell[TextData[{
 "Evaluating this cell emits ",
 StyleBox["GreaterEqual::nord: Invalid comparison with 10 I attempted.", 
  "Program"],
 " because the real-domain discriminant test tries to compare 2\[ImaginaryI] \
Sqrt[5] against 0."
}], "ExampleText",
 CellID->478981238,ExpressionUUID->"7c89b73d-32be-424d-87fd-3dc613c8fc8f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "\[Rule]", 
    RowBox[{"\[ImaginaryI]", " ", 
     SqrtBox["5"], " ", 
     RowBox[{"signA", "[", "1", "]"}]}]}], ",", 
   RowBox[{"y", "\[Rule]", 
    RowBox[{"\[ImaginaryI]", " ", 
     SqrtBox["5"], " ", 
     RowBox[{"signA", "[", "1", "]"}]}]}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->478991239,ExpressionUUID->"ab9581ba-8c27-4f9a-b511-167fd6eaa737"],

Cell["Inconsistent systems return with leftover equations:", "ExampleText",
 CellID->479012345,ExpressionUUID->"c9d0e1f2-a3b4-c5d6-e7f8-a9b0c1d2e3f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"result", "=", 
  RowBox[{"paramQuadSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], "\[Equal]", "4"}], ",", 
      RowBox[{"x", "\[Equal]", "3"}]}], "}"}], ",", 
    RowBox[{"{", "x", "}"}], ",", 
    RowBox[{"Diagnostics", "\[Rule]", "True"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"result", "[", "\"\<Diagnostics\>\"", "]"}], 
  "[", "\"\<LeftoverEquations\>\"", "]"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->480123456,ExpressionUUID->"d0e1f2a3-b4c5-d6e7-f8a9-a0b1c2d3e4f5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", "-", 
   SuperscriptBox["x", "2"]}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->481234567,ExpressionUUID->"e1f2a3b4-c5d6-e7f8-a9b0-c1d2e3f4a5b6"]
}, Open  ]],

Cell[TextData[{
 "Systems that timeout can be given more time with the ",
 Cell[BoxData[
  ButtonBox["Timeout",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "f2a3b4c5-d6e7-f8a9-b0c1-d2e3e4f5a6b7"],
 " option (in seconds)."
}], "ExampleText",
 CellID->482345678,ExpressionUUID->"a3b4c5d6-e7f8-a9b0-c1d2-e3f4a5b6c7d8"]
}, Open  ]]
}, Open  ]],

