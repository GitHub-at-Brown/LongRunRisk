   RowBox[{
    RowBox[{"y", "+", 
     RowBox[{"2", " ", "x"}]}], "\[Equal]", "c"}], ",", 
   RowBox[{"z", "\[Equal]", 
    RowBox[{
     RowBox[{"3", " ", "a"}], "+", "b"}]}]}], "}"}]], "Output",
 CellLabel->"Out[6]=",
