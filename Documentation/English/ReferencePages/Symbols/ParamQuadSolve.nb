           RowBox[{
            FractionBox["9", "4"], "-", "delta"}]]}]}]}]}], "}"}], 
     RowBox[{"{", 
      RowBox[{"A", "\[Rule]", 
       RowBox[{
        FractionBox["3", "2"], "+", 
        FractionBox[
