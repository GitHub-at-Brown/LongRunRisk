Cell["\<\
PlotCoeffs is an advanced diagnostic tool used during model solution to \
visualize the convergence of FindRoot when solving for coefficients. It is \
typically called internally by the solver, but can be used manually for \
debugging:\
\>", "ExampleText",
 CellID->123456789,ExpressionUUID->"ab123456-1234-1234-1234-123456789abc"],

Cell[BoxData[
 RowBox[{"model", "=", 
  RowBox[{"First", "@", "Models"}]}]], "Input",
 CellLabel->" In[1]:=",
 CellID->987654321,ExpressionUUID->"cd123456-1234-1234-1234-123456789def"],

Cell["\<\
PlotCoeffs is an advanced diagnostic tool that visualizes FindRoot iteration \
steps during coefficient solution. It requires intermediate solution data \
from the model solving process:\
\>", "ExampleText",
 CellID->123456790,ExpressionUUID->"ab123457-1234-1234-1234-123456789abc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Example", " ", "usage", " ", "with", " ", "solution", " ", "data"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"sol", " ", "=", " ", 
     RowBox[{
     "intermediate", " ", "solution", " ", "from", " ", "model", " ", 
      "solver"}]}], ";"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"params", " ", "=", " ", 
     RowBox[{"model", "[", "\"\<parameters\>\"", "]"}]}], ";"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Ewc0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"PlotCoeffs", "[", 
    RowBox[{
    "model", ",", " ", "sol", ",", " ", "params", ",", " ", "Ewc0", ",", " ", 
     
     RowBox[{"PlotLegends", "\[Rule]", "Automatic"}]}], "]"}], " ", 
   "*)"}]}]], "Input",
 CellLabel->" In[2]:=",
 CellID->987654323,ExpressionUUID->"cd123458-1234-1234-1234-123456789def"]
}, Open  ]],

