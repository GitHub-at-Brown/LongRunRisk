Cell[CellGroupData[{
Cell["PlotCoeffs", "ObjectName",
 CellID->1952266384,ExpressionUUID->"127de428-ab44-4a4a-94ac-4fad2066f9d1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"234549c8-997f-4b98-822c-d94ec6630af5"],
 "PlotCoeffs[model_Association,sol_List,parameters_List,Ewc0_List,opts: ",
 Cell[BoxData[
  ButtonBox["OptionsPattern",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a2bba03c-70ea-4d68-b965-838246ddc056"],
 "[]]\[LineSeparator]plots the steps that ",
 Cell[BoxData[
  ButtonBox["FindRoot",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "746ed626-6511-4e0a-90ca-163056759537"],
 " takes to solve for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["A",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/A"], "[", "0", "]"}]],
  "InlineFormula",ExpressionUUID->"e54e65fb-112e-4465-8283-574aea30f8cb"]
}], "Usage",
 CellChangeTimes->{{3.9710582802050943`*^9, 3.971058280850931*^9}, {
  3.971058348906432*^9, 3.971058352999913*^9}, {3.9710583905941963`*^9, 
  3.9710583954572363`*^9}},
 CellID->338473375,ExpressionUUID->"9f9865cb-ff84-4d59-84d5-2a31cb42fb4c"],

Cell["\<\
PlotCoeffs visualizes the iterative solution process when FindRoot solves for \
the coefficient A[0] in the wealth-consumption ratio.\
\>", "Notes",
 CellID->37832721,ExpressionUUID->"2b84441e-e426-4a70-9a65-cb050e098d0a"],

Cell["\<\
This diagnostic tool is useful for understanding convergence behavior and \
troubleshooting numerical solution issues.\
\>", "Notes",
 CellID->37832722,ExpressionUUID->"2b84441e-e426-4a70-9a65-cb050e098d0b"],

Cell["\<\
The function returns a plot showing how FindRoot approaches the solution, \
along with the equation being solved and the initial conditions.\
\>", "Notes",
 CellID->37832723,ExpressionUUID->"2b84441e-e426-4a70-9a65-cb050e098d0c"]
}, Open  ]],

