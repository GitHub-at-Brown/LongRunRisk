}], "Notes",
 CellChangeTimes->{{3.97160024*^9, 3.97160025*^9}},
 CellID->100000004,ExpressionUUID->"816ebd59-1ac8-4f47-bc9b-323c9f608525"],

Cell["Ev holds its first argument to prevent premature evaluation.", "Notes",
 CellChangeTimes->{{3.97160026*^9, 3.97160027*^9}},
 CellID->100000005,ExpressionUUID->"7a32c705-e69f-497a-8e19-05453500f1c9"],

Cell["\<\
The result is computed by replacing shocks with zero (their conditional \
expectation) and applying the model's exogenous and endogenous equations to \
lag state variables appropriately.\
\>", "Notes",
 CellChangeTimes->{{3.97160028*^9, 3.97160029*^9}},
 CellID->100000006,ExpressionUUID->"3124d620-8b79-4bde-be9d-31f62d64cc23"]
}, Open  ]],

