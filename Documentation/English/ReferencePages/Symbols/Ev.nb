Cell[CellGroupData[{
Cell["Ev", "ObjectName",
 CellID->123456789,ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Ev",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Ev"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["s", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c1d2e3f4-a5b6-7890-cdef-012345678902"],
 "\[LineSeparator]gives the conditional expectation of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "d1e2f3a4-b5c6-7890-def0-123456789abc"],
 " given information at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "e1f2a3b4-c5d6-7890-ef01-23456789abcd"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "f1a2b3c4-d5e6-7890-f012-3456789abcde"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9716*^9, 3.9716001*^9}},
 CellID->100000001,ExpressionUUID->"56809e57-c6ac-45ad-8b82-e9e263234685"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "a2b3c4d5-e6f7-8901-2345-6789abcdef01"],
 " can be any expression involving model variables and parameters."
}], "Notes",
 CellChangeTimes->{{3.9716002*^9, 3.97160021*^9}},
 CellID->100000002,ExpressionUUID->"b11f99aa-5c04-40fa-8cc2-5e40594ccd0d"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "b2c3d4e5-f6a7-8901-2345-6789abcdef02"],
 " is the conditioning time, typically ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-2345-6789abcdef03"],
 " or ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "d2e3f4a5-b6c7-8901-2345-6789abcdef04"],
 "."
}], "Notes",
 CellChangeTimes->{{3.97160022*^9, 3.97160023*^9}},
 CellID->100000003,ExpressionUUID->"cc75ce98-6a80-48a8-bd68-79fe18d2dbd9"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "e2f3a4b5-c6d7-8901-2345-6789abcdef05"],
 " should be a model specification from ",
 Cell[BoxData[
  ButtonBox["Models",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Models"]], 
  "InlineFormula",ExpressionUUID->"f2a3b4c5-d6e7-8901-2345-6789abcdef06"],
