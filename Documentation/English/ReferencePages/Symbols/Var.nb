Notebook[{

Cell[CellGroupData[{
Cell["Var", "ObjectName",
 CellID->2069626918,ExpressionUUID->"7fcd4220-f577-472c-bc35-491c3f5e408c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79474c23-ad33-45ba-bd51-34903c32a2f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Var",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Var"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["s", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d4385a3b-5c69-4313-b3f5-33d617635d7f"],
 "\[LineSeparator]gives the conditional variance of ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "3f1456e2-a67d-4437-84d1-a69faaf65dc7"],
 " given information at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "4a2b3c4d-5e6f-7890-1234-567890abcdef"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "5a3b4c5d-6e7f-8901-2345-67890abcdef0"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9710582837246237`*^9, 3.971058302535624*^9}, {3.9717*^9,
   3.9717001*^9}},
 CellID->1426980367,ExpressionUUID->"b019eb87-3e82-4a47-adb9-be1adfb08afa"],

Cell[TextData[{
 "Var is computed as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["E", "s"], "[", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"expr", "-", 
      RowBox[{
       SubscriptBox["E", "s"], "[", "expr", "]"}]}], ")"}], "2"], "]"}]], 
  "InlineFormula",ExpressionUUID->"6a4b5c6d-7e8f-9012-3456-7890abcdef01"],
 " where ",
 Cell[BoxData[
  SubscriptBox["E", "s"]], "InlineFormula",ExpressionUUID->
  "7a5b6c7d-8e9f-0123-4567-890abcdef012"],
 " denotes conditional expectation at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "8a6b7c8d-9e0f-1234-5678-90abcdef0123"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9717002*^9, 3.97170021*^9}},
 CellID->161658473,ExpressionUUID->"9e7399f4-666a-46a4-9334-ec4cc5556da1"],

Cell[TextData[{
 "For two expressions, ",
 Cell[BoxData[
  RowBox[{"Var", "[",
   RowBox[{
    SubscriptBox[
     StyleBox["expr", "TI"], "1"], ",",
    StyleBox["s", "TI"], ",",
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9a7b8c9d-0e1f-2345-6789-0abcdef01234"],
 " equals ",
 Cell[BoxData[
  RowBox[{"Cov", "[",
   RowBox[{
    SubscriptBox[
     StyleBox["expr", "TI"], "1"], ",",
    SubscriptBox[
     StyleBox["expr", "TI"], "1"], ",",
    StyleBox["s", "TI"], ",",
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "aa8b9ca0-1e2f-3456-789a-bcdef0123456"],
 "."
}], "Notes",
 CellChangeTimes->{{3.97170022*^9, 3.97170023*^9}},
 CellID->161658474,ExpressionUUID->"aa8b9ca0-1e2f-3456-789a-bcdef0123456"],

Cell["\<\
Var holds its first argument to prevent premature evaluation.\
\>", "Notes",
 CellChangeTimes->{{3.97170024*^9, 3.97170025*^9}},
 CellID->161658475,ExpressionUUID->"ba9b0ca1-2e3f-4567-89ab-cdef01234567"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "ca0b1ca2-3e4f-5678-9abc-def012345678"],
 " should be a model specification from ",
 Cell[BoxData[
  ButtonBox["Models",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Models"]], 
  "InlineFormula",ExpressionUUID->"da1b2ca3-4e5f-6789-abcd-ef0123456789"],
 "."
}], "Notes",
 CellChangeTimes->{{3.97170026*^9, 3.97170027*^9}},
 CellID->161658476,ExpressionUUID->"ea2b3ca4-5e6f-789a-bcde-f01234567890"]
}, Open  ]],

