Cell[CellGroupData[{
Cell["ToEquation", "ObjectName",
 CellID->1618457860,ExpressionUUID->"5ca090aa-21e6-49c9-a458-1c8444422726"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa5e7d8c-c8a8-4be0-8427-f8d5fe51b600"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToEquation",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9efa51a7-b7b8-4229-8641-fe2cc25d568d"],
 "\[LineSeparator]gives a pure (or \"anonymous\") function that re-writes its \
argument in terms of lagged exogenous variables and shocks of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "b9c2cd07-dac3-4a15-b985-214078d04a84"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a03b7e1e-44f4-49c8-85d9-18bafa4011ad"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToEquation",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "31e2b114-6e3e-4aab-a5eb-f9494b8bfcc8"],
 "\[LineSeparator]re-writes ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "e3c63e8b-3249-4ead-8ea6-a71757f6afd2"],
 " in terms of lagged exogenous variables and shocks of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "083ab055-410e-4bb2-a437-4ccae7914253"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9717171290233507`*^9, 3.971717129104471*^9}, {
  3.9717171673456*^9, 3.9717171678945*^9}},
 CellID->1393380118,ExpressionUUID->"88a46310-540c-466b-988f-91897664ed0c"],

Cell["\<\
ToEquation rewrites expressions by recursively applying the model's \
endogenous and exogenous equations until the expression contains only lagged \
exogenous variables and shocks.\
\>", "Notes",
 CellChangeTimes->{{3.9717171834567*^9, 3.9717172145678*^9}},
 CellID->230472691,ExpressionUUID->"8033757c-798e-4dc8-ba2a-2fb4f51f40bc"]
}, Open  ]],

