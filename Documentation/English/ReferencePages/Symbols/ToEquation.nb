Cell["ToEquation", "ObjectName",
 CellID->784716630,ExpressionUUID->"5b7d53b0-ec61-4892-9f09-971feeeb9ca2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cca08862-89a6-4115-89e3-05380feed312"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToEquation",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"], "[", 
   StyleBox["model", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "76ecdf29-6eca-47cc-9be3-9083840d63da"],
 "\[LineSeparator]gives a pure (or \"anonymous\") function that re-writes its \
argument in terms of lagged exogenous variables and shocks of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "f78ae1cc-fe5a-4d41-8815-3907e7884451"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"182e454d-f4dd-4859-bc4d-1e3e0a563890"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToEquation",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3b7fc0b8-d161-4a00-9002-1532a9ba3b7c"],
 "\[LineSeparator]re-writes ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "0fa343c5-09c8-4d00-a9ee-8ef778a08dd5"],
 " in terms of lagged exogenous variables and shocks of ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "f175b3fe-1993-45dc-a0dd-856257fb3d3f"],
 "."
}], "Usage",
 CellChangeTimes->{{3.97105828122674*^9, 3.97105828127914*^9}},
 CellID->1035324183,ExpressionUUID->"3a84f664-1530-4382-986f-66e9630fba91"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToEquation",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"]], 
  "InlineFormula",ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 " expands expressions by substituting endogenous variable definitions from \
the model, then applies exogenous variable equations."
}], "Notes",
 CellID->1781035687,ExpressionUUID->"8a653b12-00ee-40e4-be18-00c9e6878858"],

Cell["\<\
The result expresses quantities in terms of the exogenous state variables and \
their lags, plus the exogenous shocks.\
\>", "Notes",
 CellID->912345678,ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToEquation",
