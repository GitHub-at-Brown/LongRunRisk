  RowBox[{
   RowBox[{"dc", "[", "t", "]"}], ",", "model"}], "]"}]], "Input",
 CellLabel->" In[2]:=",
 CellID->234567891,ExpressionUUID->"32eb1c6b-d4e8-4a68-b6b1-80200fb13657"],

Cell[OutputFormData["\<\
                          2
muc + x[-1 + t] + Sqrt[Esx  + sx[-1 + t]] eps[dc][t]\
\>"], "Output",
