Notebook[{

Cell[CellGroupData[{
Cell["Models", "ObjectName",
 CellID->1090470216,ExpressionUUID->"8784793a-ecee-4fb8-bd50-7e4cc7bdb892"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e439874-15fb-411a-8873-893fb998b2e1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Models",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Models"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"82ce5176-7e14-43af-bdcc-0c8daabdfe2a"],
 "\[LineSeparator]returns an association containing all available long-run \
risk model specifications."
}], "Usage",
 CellChangeTimes->{{3.9717171273467617`*^9, 3.97171715*^9}},
 CellID->907476814,ExpressionUUID->"722eeb4f-04f7-40e5-9f25-aa3a9e727191"],

Cell[TextData[{
 "The returned association has model names as keys (e.g., ",
 Cell[BoxData[
  StyleBox["\"\<BY\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<BKY\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "a1b2c3d5-e5f6-7890-abcd-ef1234567890"],
 ") and model specifications as values. Each model specification contains \
parameters, state variables, equations, and other model properties."
}], "Notes",
 CellChangeTimes->{{3.97171716*^9, 3.9717172*^9}},
 CellID->533951904,ExpressionUUID->"419b9e89-e36d-470b-a425-af5cf2de7bbc"]
}, Open  ]],

