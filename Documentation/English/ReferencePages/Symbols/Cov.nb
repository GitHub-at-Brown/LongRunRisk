Notebook[{

Cell[CellGroupData[{
Cell["Cov", "ObjectName",
 CellID->2134805352,ExpressionUUID->"f623f0bf-40c7-4de0-aebf-bf9069f10890"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a0c131f-2cc4-4e17-a0db-f0adffda8d6c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Cov",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Cov"], "[", 
   RowBox[{
    StyleBox["expr1", "TI"], ",", 
    StyleBox["expr2", "TI"], ",", 
    StyleBox["s", "TI"], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "459bf6dd-ddeb-4044-a89d-417018a45400"],
 "\[LineSeparator]gives the conditional covariance of ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "7a1127ee-a9cc-446b-8816-7e630a6d27b0"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "8b2238ff-ba0d-557b-9927-8e741fa7e3c1"],
 " given information at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "9c3349aa-cb1e-668c-a038-9f852ab8f4d2"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "ad445abb-dc2f-779d-b149-a096bbc9e5e3"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058279008975*^9, 3.9710584685989227`*^9}, {3.9718*^9,
   3.9718001*^9}},
 CellID->1664260635,ExpressionUUID->"b74fb1eb-ce8c-4a75-88e8-516b4c0a0f80"],

Cell[TextData[{
 "Cov is computed as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["E", "s"], "[", 
   RowBox[{"(", 
    RowBox[{"expr1", "-", 
     RowBox[{
      SubscriptBox["E", "s"], "[", "expr1", "]"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"expr2", "-", 
     RowBox[{
      SubscriptBox["E", "s"], "[", "expr2", "]"}]}], ")"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"be556bcc-ed30-88ae-c25a-b1a7ccda06f4"],
 " where ",
 Cell[BoxData[
  SubscriptBox["E", "s"]], "InlineFormula",ExpressionUUID->
  "64f47704-702c-4c08-8c52-ab45439cdbe8"],
 " denotes conditional expectation at time ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "39e7352e-5766-4783-9aa4-65228db2119c"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9718002*^9, 3.97180021*^9}},
 CellID->253990270,ExpressionUUID->"bb40422f-a885-47ea-bf11-26260e2341f2"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "0c122328-9ea8-4a3d-ab4d-0e37e176cb4f"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "e19b2253-0afe-4eda-9b03-669828633344"],
 " can be any expressions involving model variables and parameters."
}], "Notes",
 CellChangeTimes->{{3.97180022*^9, 3.97180023*^9}},
 CellID->253990271,ExpressionUUID->"88090a51-c0d2-4910-b37d-45c7b7c3074d"],

Cell["\<\
Cov holds its first argument to prevent premature evaluation.\
\>", "Notes",
 CellChangeTimes->{{3.97180024*^9, 3.97180025*^9}},
 CellID->253990272,ExpressionUUID->"1cf4ea88-9c12-4f6e-91c9-0592abc6518b"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "cfcccddd-dfea-affa-e39c-228beddab7d1"],
 " should be a model specification from ",
 Cell[BoxData[
  ButtonBox["Models",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Models"]], 
  "InlineFormula",ExpressionUUID->"aadcfbc8-78a5-4aea-9c81-e7eb182dea95"],
 "."
}], "Notes",
 CellChangeTimes->{{3.97180026*^9, 3.97180027*^9}},
 CellID->253990273,ExpressionUUID->"ebeeefff-bacc-cbbc-a5be-44adaffcd9f3"]
}, Open  ]],

