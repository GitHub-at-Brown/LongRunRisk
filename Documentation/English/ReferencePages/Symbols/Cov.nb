Cell["\<\
Compute the conditional covariance of consumption and dividend growth:\
\>", "ExampleText",
 CellChangeTimes->{{3.9718006*^9, 3.97180061*^9}},
 CellID->500000008,ExpressionUUID->"cfcccddd-dfed-ddfe-ebae-bcefaaaaafe1"],

Cell[BoxData[
 RowBox[{"Cov", "[",
  RowBox[{
   RowBox[{"dc", "[",
    RowBox[{"t", "+", "1"}], "]"}], ",",
   RowBox[{"dd", "[",
    RowBox[{
     RowBox[{"t", "+", "1"}], ",", "1"}], "]"}], ",", "t", ",", "model"}],
  "]"}]], "Input",
 CellChangeTimes->{{3.97180062*^9, 3.97180063*^9}},
 CellLabel->"In[1]:=",
 CellID->500000009,ExpressionUUID->"dadddeee-afee-eaff-cbfc-dfabbbbbff26"],

Cell["\<\
Compute the covariance between stock return and consumption growth:\
\>", "ExampleText",
 CellChangeTimes->{{3.97180064*^9, 3.97180065*^9}},
 CellID->500000010,ExpressionUUID->"ebeeefff-baff-fbaa-dcad-eabccccaaa37"],

Cell[BoxData[
 RowBox[{"Cov", "[",
  RowBox[{
   RowBox[{"rd", "[",
    RowBox[{
     RowBox[{"t", "+", "1"}], ",", "1"}], "]"}], ",",
   RowBox[{"dc", "[",
    RowBox[{"t", "+", "1"}], "]"}], ",", "t", ",", "model"}], "]"}]], "Input",
 CellChangeTimes->{{3.97180066*^9, 3.97180067*^9}},
 CellLabel->"In[2]:=",
 CellID->500000011,ExpressionUUID->"fcfffaaa-cbaa-acbb-edbe-fbcddddbbbb4"],

Cell["Covariance with itself equals the variance:", "ExampleText",
 CellChangeTimes->{{3.97180068*^9, 3.97180069*^9}},
 CellID->500000012,ExpressionUUID->"82174dd6-e03b-41df-b809-3fe5b78f6e74"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"expr", "=",
   RowBox[{"dc", "[",
    RowBox[{"t", "+", "1"}], "]"}]}], ";"}], "\n",
 RowBox[{
  RowBox[{"Cov", "[",
   RowBox[{"expr", ",", "expr", ",", "t", ",", "model"}], "]"}], "==",
  RowBox[{"Var", "[",
   RowBox[{"expr", ",", "t", ",", "model"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9718007*^9, 3.97180071*^9}},
 CellLabel->"In[3]:=",
 CellID->500000013,ExpressionUUID->"bebbbccc-edcc-cedd-afdf-bdefeffffa6a"]
}, Open  ]],

