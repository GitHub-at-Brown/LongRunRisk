Notebook[{

Cell[CellGroupData[{
Cell["UncondCov", "ObjectName",
 CellID->79995818,ExpressionUUID->"ca50a22b-0334-4819-8035-c93dd3f8c944"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1c9e251-d507-439b-9a4a-ef26cf48de23"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UncondCov",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCov"], "[",
   RowBox[{
    StyleBox["expr1", "TI"], ",",
    StyleBox["expr2", "TI"], ",",
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7c2ce9c4-260b-49c3-ab17-88a0b191ab36"],
 "\[LineSeparator]gives the unconditional covariance between ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "a250f418-7b13-4b63-90f1-0938851b609f"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "3eb055d2-3408-4320-bbe4-e1eeb7885aba"],
 " for the specified ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "1966766b-cb11-47af-bdee-cf9a724bca1a"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058282851946*^9, 3.971058282890993*^9}, {3.97161*^9, 
  3.9716101*^9}},
 CellID->164950104,ExpressionUUID->"e35bae27-d024-44a3-b838-78d7d91595e7"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondCov",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCov"]], 
  "InlineFormula",ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd98"],
 " is computed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"UncondE", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"expr1", "-", 
       RowBox[{"UncondE", "[", 
        RowBox[{"expr1", ",", "model"}], "]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"expr2", "-", 
       RowBox[{"UncondE", "[", 
        RowBox[{"expr2", ",", "model"}], "]"}]}], ")"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd99"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9716102*^9, 3.97161025*^9}},
 CellID->2062493298,ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9a"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondCov",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCov"]], 
  "InlineFormula",ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9b"],
 " computes covariance with respect to the stationary distribution of the \
model."
}], "Notes",
 CellChangeTimes->{{3.9716103*^9, 3.97161035*^9}},
 CellID->2062493299,ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9c"],

Cell[TextData[{
 "When both expressions are the same, ",
 Cell[BoxData[
  ButtonBox["UncondCov",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCov"]], 
  "InlineFormula",ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9d"],
 " equals ",
 Cell[BoxData[
  ButtonBox["UncondVar",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondVar"]], 
  "InlineFormula",ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9e"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9716104*^9, 3.97161045*^9}},
 CellID->2062493300,ExpressionUUID->"ac7f4206-c4f5-4ca8-b025-f9222621cd9f"]
}, Open  ]],

