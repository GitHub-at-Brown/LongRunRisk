Cell[CellGroupData[{
Cell["UncondCorr", "ObjectName",
 CellID->1527917265,ExpressionUUID->"c33df6e5-d42e-43dd-baa7-f4e4c85ba47f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35bb5ebc-83a7-44d0-94cf-2e9fececcb14"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UncondCorr",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCorr"], "[",
   RowBox[{
    SubscriptBox[
     StyleBox["expr", "TI"],
     StyleBox["1", "TR"]], ",",
    SubscriptBox[
     StyleBox["expr", "TI"],
     StyleBox["2", "TR"]], ",",
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3c5f3306-792a-4f99-907a-ffa281b018fa"],
 "\[LineSeparator]gives the unconditional correlation of ",
 Cell[BoxData[
  StyleBox["expr1", "TI"]], "InlineFormula",ExpressionUUID->
  "f11efca2-c77e-48e6-baec-a0c3b71eda7f"],
 " and ",
 Cell[BoxData[
  StyleBox["expr2", "TI"]], "InlineFormula",ExpressionUUID->
  "6a0fd2b9-93e4-4842-86b8-45f9796d23cd"],
 " for ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "7b73a998-2197-4c68-bb81-f4850722004f"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971058282560409*^9, 3.971058282601033*^9}},
 CellID->96022029,ExpressionUUID->"7f84600b-19e2-4544-bbc7-8e0438dc088e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondCorr",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCorr"]],
  "InlineFormula",ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 " computes the unconditional correlation between two expressions with \
respect to the stationary distribution of the model."
}], "Notes",
 CellID->1082022506,ExpressionUUID->"e3bc93be-ba27-400b-a067-db3951b79c91"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["UncondCorr",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCorr"]],
  "InlineFormula",ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],
 " is computed as ",
 Cell[BoxData[
  FractionBox[
   ButtonBox["UncondCov",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCov"],
   RowBox[{
    SqrtBox[
     SubscriptBox["UncondVar", "1"]],
    SqrtBox[
     SubscriptBox["UncondVar", "2"]]}]]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-cdef-123456789012"],
 ", where ",
 Cell[BoxData[
  SubscriptBox["UncondVar", "1"]], "InlineFormula",ExpressionUUID->
  "d3e4f5a6-b7c8-9012-def1-234567890123"],
 " and ",
 Cell[BoxData[
  SubscriptBox["UncondVar", "2"]], "InlineFormula",ExpressionUUID->
  "e4f5a6b7-c8d9-0123-ef12-345678901234"],
 " are the unconditional variances of the two expressions."
}], "Notes",
 CellID->234567890,ExpressionUUID->"f5a6b7c8-d9e0-1234-f123-456789012345"],

Cell[TextData[{
 "Unlike ",
 Cell[BoxData[
  ButtonBox["Corr",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/Corr"]], "InlineFormula",
  ExpressionUUID->"a6b7c8d9-e0f1-2345-1234-567890123456"],
 ", ",
 Cell[BoxData[
  ButtonBox["UncondCorr",
   BaseStyle->"Link",
