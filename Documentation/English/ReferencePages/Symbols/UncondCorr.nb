Notebook[{

Cell[CellGroupData[{
Cell["UncondCorr", "ObjectName",
 CellID->549816427,ExpressionUUID->"3f79292e-c2aa-4843-8f80-2031ff00a096"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"463d49b2-c64b-41a4-a1cb-8a01719197f3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UncondCorr",
    BaseStyle->"Link",
    ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/UncondCorr"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["expr", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["expr", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["model", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ad3d6f09-437e-469f-88db-b599499655b7"],
 "\[LineSeparator]gives the unconditional correlation of ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["expr", "TI"], 
   StyleBox["1", "TR"]]], "InlineFormula",ExpressionUUID->
  "e3647d0a-c783-4dc5-9b5c-44051da927ed"],
 " and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["expr", "TI"], 
   StyleBox["2", "TR"]]], "InlineFormula",ExpressionUUID->
  "061dcb53-1df3-4b0a-8721-1a4368074d92"],
 " for ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "ca6d661c-54d3-46bd-9e83-8a404a323102"],
 "."
}], "Usage",
 CellChangeTimes->{{3.971717130128275*^9, 3.971717130236763*^9}},
 CellID->142555548,ExpressionUUID->"7aa09d8a-ce9e-43a8-9b30-d3c89e157b83"],

Cell["\<\
UncondCorr computes the unconditional (long-run) correlation between two \
expressions based on the model's dynamics.\
\>", "Notes",
 CellID->1486828831,ExpressionUUID->"c9eea542-dae6-442c-bfed-69636b9c03b0"],

Cell["\<\
UncondCorr is defined as UncondCov[expr1, expr2, model] / \
(Sqrt[UncondVar[expr1, model]] Sqrt[UncondVar[expr2, model]]).\
\>", "Notes",
 CellID->1486828832,ExpressionUUID->"d9eea542-dae6-442c-bfed-69636b9c03b1"],

Cell["\<\
The unconditional correlation is always between -1 and 1, and equals 1 when \
an expression is correlated with itself.\
\>", "Notes",
 CellID->1486828833,ExpressionUUID->"e9eea542-dae6-442c-bfed-69636b9c03b2"]
}, Open  ]],

