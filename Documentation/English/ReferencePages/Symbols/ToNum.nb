Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToNum",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToNum"]], 
  "InlineFormula",ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],
 " first uses ",
 Cell[BoxData[
  ButtonBox["ToEquation",
   BaseStyle->"Link",
   ButtonData->"paclet:FernandoDuarte/LongRunRisk/ref/ToEquation"]], 
  "InlineFormula",ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],
 " to express the argument in terms of exogenous variables and shocks, then \
