Cell["Evaluate an expression numerically:", "ExampleText",
 CellID->567890123,ExpressionUUID->"4eacb0d8-4859-4e3c-a69c-c26569ede71b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "[",
  RowBox[{"E", "^",
   RowBox[{"(",
    RowBox[{"muc", "+",
     RowBox[{"rhox", " ", "x", "[", "t", "]"}]}], ")"}]}], "]"}]], "Input",
 CellLabel->" In[4]:=",
 CellID->678901234,ExpressionUUID->"847e60af-97b4-47ce-bcf1-43af14ae2cae"],

Cell[OutputFormData["\<\
                   muc + x[t] rhox
1.00151 E\
\>"], "Output",
