Cell[BoxData[
 RowBox[{"model", "=",
  RowBox[{"ProcessModel", "[",
   RowBox[{"\"\<BY09\>\"", ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"muc", "->", "0.0015"}], ",",
      RowBox[{"rhox", "->", "0.975"}]}], "}"}]}], "]"}]}]], "Input",
