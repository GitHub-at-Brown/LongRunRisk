}], "Notes",
 CellID->702342567,ExpressionUUID->"688de85c-019c-4c7e-8d7a-f6b8b20c070c"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["parameters", "TI"]], "InlineFormula",ExpressionUUID->
  "c2d3e4f5-a6b7-8901-cdef-123456789012"],
