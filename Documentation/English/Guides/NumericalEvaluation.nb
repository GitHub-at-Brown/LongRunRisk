Cell[CellGroupData[{

Cell["Understanding Parameter Relationships", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000036,ExpressionUUID->"b1c2d3e4-f5a6-7890-2345-678901234567"],

Cell["\<\
The parameters gamma, psi, and theta are related by the equation: theta = \
(1-gamma)/(1-1/psi). ToNum automatically enforces this relationship.\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000037,ExpressionUUID->"c1d2e3f4-a5b6-7890-3456-789012345678"],

Cell[CellGroupData[{

Cell["Verify the relationship:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000038,ExpressionUUID->"d1e2f3a4-b5c6-7890-4567-890123456789"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"{",
   RowBox[{"theta", ",", "gamma", ",", "psi"}], "}"}], "//",
  RowBox[{"ToNum", "[", "myModel", "]"}]}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"theta", "==",
   RowBox[{
    RowBox[{"(",
     RowBox[{"1", "-", "gamma"}], ")"}], "/",
    RowBox[{"(",
     RowBox[{"1", "-",
      RowBox[{"1", "/", "psi"}]}], ")"}]}]}], "//",
  RowBox[{"ToNum", "[", "myModel", "]"}]}]}], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[16]:=",
 CellID->100000039,ExpressionUUID->"e1f2a3b4-c5d6-7890-5678-901234567890"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{"-", "26.999999999999996`"}], ",", "10", ",", "1.5`"}],
  "}"}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"Out[16]=",
 CellID->100000040,ExpressionUUID->"f1a2b3c4-d5e6-7890-6789-012345678901"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[17]=",
 CellID->100000041,ExpressionUUID->"a1b2c3d4-e5f6-7890-7890-123456789012"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["ToNum enforces the relationship:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000042,ExpressionUUID->"b1c2d3e4-f5a6-7890-8901-234567890123"],

Cell["\<\
If you change psi, theta will be automatically recalculated to maintain the \
relationship:\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000043,ExpressionUUID->"c1d2e3f4-a5b6-7890-9012-345678901234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{",
   RowBox[{"theta", ",", "gamma", ",", "psi"}], "}"}], "//",
  RowBox[{"ToNum", "[",
   RowBox[{"myModel", ",",
    RowBox[{"{",
     RowBox[{"psi", "->", "2"}], "}"}]}], "]"}]}]], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[18]:=",
 CellID->100000044,ExpressionUUID->"d1e2f3a4-b5c6-7890-0123-456789012345"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{"-", "18"}], ",", "10", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"Out[18]=",
 CellID->100000045,ExpressionUUID->"e1f2a3b4-c5d6-7890-1234-567890123456"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

