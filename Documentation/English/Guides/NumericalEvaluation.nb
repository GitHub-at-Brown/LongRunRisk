Notebook[{

Cell[CellGroupData[{
Cell["Numerical Evaluation", "Title",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->1671110463,ExpressionUUID->"a1b2c3d4-e5f6-7890-abcd-ef1234567890"],

Cell["\<\
This tutorial shows how to evaluate model expressions numerically using \
ToNum. The ToNum function solves the model and substitutes numerical values \
for all parameters and solution coefficients.\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->123456789,ExpressionUUID->"b1c2d3e4-f5a6-7890-bcde-f12345678901"],

Cell[CellGroupData[{

Cell["Setup", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000001,ExpressionUUID->"c1d2e3f4-a5b6-7890-cdef-123456789012"],

Cell[CellGroupData[{

Cell["Load the paclet:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000002,ExpressionUUID->"d1e2f3a4-b5c6-7890-def1-234567890123"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<FernandoDuarte`LongRunRisk`\>\"", "]"}]], "Input",\

 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[1]:=",
 CellID->100000003,ExpressionUUID->"e1f2a3b4-c5d6-7890-ef12-345678901234"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Select a model to work with:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000004,ExpressionUUID->"f1a2b3c4-d5e6-7890-f123-456789012345"],

Cell[BoxData[
 RowBox[{"myModel", "=",
  RowBox[{"Models", "[", "\"\<BKY\>\"", "]"}]}]], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[2]:=",
 CellID->100000005,ExpressionUUID->"a1b2c3d4-e5f6-7890-1234-567890123456"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Basic Numerical Evaluation", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000006,ExpressionUUID->"b1c2d3e4-f5a6-7890-2345-678901234567"],

Cell["\<\
The primary use of ToNum is to evaluate expressions numerically. First \
convert an expression to a form that depends on solution coefficients using \
ToEquation, then evaluate numerically with ToNum.\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000007,ExpressionUUID->"c1d2e3f4-a5b6-7890-3456-789012345678"],

Cell[CellGroupData[{

Cell["Create an expression and evaluate it numerically:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000008,ExpressionUUID->"d1e2f3a4-b5c6-7890-4567-890123456789"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"myEq", "=",
  RowBox[{
   RowBox[{"wc", "[", "t", "]"}], "//",
   RowBox[{"ToEquation", "[", "myModel", "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{"ToNum", "[",
  RowBox[{"myEq", ",", "myModel"}], "]"}]}], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[3]:=",
 CellID->100000009,ExpressionUUID->"e1f2a3b4-c5d6-7890-5678-901234567890"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", "0", "]"}], "+",
  RowBox[{
   RowBox[{"A", "[", "2", "]"}], " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{
   RowBox[{"A", "[", "1", "]"}], " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"Out[3]=",
 CellID->100000010,ExpressionUUID->"f1a2b3c4-d5e6-7890-6789-012345678901"],

Cell[BoxData[
 RowBox[{"6.661221374121324`", "\[VeryThinSpace]", "-",
  RowBox[{"2036.452203590676`", " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{"12.700348645580512`", " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[4]=",
 CellID->100000011,ExpressionUUID->"a1b2c3d4-e5f6-7890-7890-123456789012"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Using Custom Parameters", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000012,ExpressionUUID->"b1c2d3e4-f5a6-7890-8901-234567890123"],

Cell["\<\
ToNum uses parameters in model[\"params\"] by default, but you can override \
them by passing a list of replacement rules.\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000013,ExpressionUUID->"c1d2e3f4-a5b6-7890-9012-345678901234"],

Cell[CellGroupData[{

Cell["Change some parameters:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000014,ExpressionUUID->"d1e2f3a4-b5c6-7890-0123-456789012345"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ToNum", "[",
  RowBox[{"myEq", ",", "myModel", ",",
   RowBox[{"{",
    RowBox[{"delta", "->", "0.99"}], "}"}]}], "]"}], "\[IndentingNewLine]",
 RowBox[{"ToNum", "[",
  RowBox[{"myEq", ",", "myModel", ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{"delta", "->", "0.99"}], ",",
     RowBox[{"muc", "->", "0.001"}]}], "}"}]}], "]"}]}], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[5]:=",
 CellID->100000015,ExpressionUUID->"e1f2a3b4-c5d6-7890-1234-567890123456"],

Cell[BoxData[
 RowBox[{"4.627590238751361`", "\[VeryThinSpace]", "-",
  RowBox[{"308.30081230874885`", " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{"9.678242522238842`", " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"Out[5]=",
 CellID->100000016,ExpressionUUID->"f1a2b3c4-d5e6-7890-2345-678901234567"],

Cell[BoxData[
 RowBox[{"4.61065433081511`", "\[VeryThinSpace]", "-",
  RowBox[{"302.07098083533594`", " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{"9.633580276214909`", " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[6]=",
 CellID->100000017,ExpressionUUID->"a1b2c3d4-e5f6-7890-3456-789012345678"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Creating Reusable Substitution Rules", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000018,ExpressionUUID->"b1c2d3e4-f5a6-7890-4567-890123456789"],

Cell["\<\
For efficiency, create a list of substitution rules and use it to evaluate \
multiple expressions without re-calculating the solution.\
\>", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000019,ExpressionUUID->"c1d2e3f4-a5b6-7890-5678-901234567890"],

Cell[CellGroupData[{

Cell["Create rules once, use them multiple times:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000020,ExpressionUUID->"d1e2f3a4-b5c6-7890-6789-012345678901"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"parameterRules", "=",
   RowBox[{"ToNum", "[",
    RowBox[{"\"\<Rules\>\"", ",", "myModel"}], "]"}]}],
  ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"parameterRules", "[",
   RowBox[{"[",
    RowBox[{"1", ";;", "3"}], "]"}], "]"}],
  "\[IndentingNewLine]"}], "\[IndentingNewLine]",
 RowBox[{"myEq", "//.", "parameterRules"}], "\[IndentingNewLine]",
 RowBox[{"myEq2", "=",
  RowBox[{
   RowBox[{"pd", "[",
    RowBox[{"t", ",", "1"}], "]"}], "//",
   RowBox[{"ToEquation", "[", "myModel", "]"}]}]}], "\[IndentingNewLine]",
 RowBox[{"myEq2", "//.", "parameterRules"}]}], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[7]:=",
 CellID->100000021,ExpressionUUID->"e1f2a3b4-c5d6-7890-7890-123456789012"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{
    RowBox[{"A", "[", "0", "]"}], "\[Rule]", "6.661221374121324`"}], ",",
   RowBox[{
    RowBox[{"A", "[", "2", "]"}], "\[Rule]",
    RowBox[{"-", "2036.452203590676`"}]}], ",",
   RowBox[{
    RowBox[{"A", "[", "1", "]"}], "\[Rule]", "12.700348645580512`"}]}],
  "}"}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"Out[8]=",
 CellID->100000022,ExpressionUUID->"f1a2b3c4-d5e6-7890-8901-234567890123"],

Cell[BoxData[
 RowBox[{"6.661221374121324`", "\[VeryThinSpace]", "-",
  RowBox[{"2036.452203590676`", " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{"12.700348645580512`", " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[9]=",
 CellID->100000023,ExpressionUUID->"a1b2c3d4-e5f6-7890-9012-345678901234"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "1", "]"}], "[", "0", "]"}], "+",
  RowBox[{
   RowBox[{"x", "[", "t", "]"}], " ",
   RowBox[{
    RowBox[{"B", "[", "1", "]"}], "[", "1", "]"}]}], "+",
  RowBox[{
   RowBox[{"sx", "[", "t", "]"}], " ",
   RowBox[{
    RowBox[{"B", "[", "1", "]"}], "[", "2", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[10]=",
 CellID->100000024,ExpressionUUID->"b1c2d3e4-f5a6-7890-0123-456789012345"],

Cell[BoxData[
 RowBox[{"5.635294984901451`", "\[VeryThinSpace]", "-",
  RowBox[{"5170.496891056436`", " ",
   RowBox[{"sx", "[", "t", "]"}]}], "+",
  RowBox[{"64.39978482744715`", " ",
   RowBox[{"x", "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000110000000*^9}},
 CellLabel->"Out[11]=",
 CellID->100000025,ExpressionUUID->"c1d2e3f4-a5b6-7890-1234-567890123456"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Postfix Notation", "Section",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000026,ExpressionUUID->"d1e2f3a4-b5c6-7890-2345-678901234567"],

Cell["ToNum supports postfix notation for convenient evaluation:", "Text",
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000200000000*^9}},
 CellID->100000027,ExpressionUUID->"e1f2a3b4-c5d6-7890-3456-789012345678"],

Cell[CellGroupData[{

Cell["Use postfix notation:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000028,ExpressionUUID->"f1a2b3c4-d5e6-7890-4567-890123456789"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"myEq", "//",
  RowBox[{"ToNum", "[", "myModel", "]"}]}], "\[IndentingNewLine]",
 RowBox[{"myEq", "//",
  RowBox[{"ToNum", "[",
   RowBox[{"myModel", ",",
    RowBox[{"{",
     RowBox[{"delta", "->", "0.9"}], "}"}]}], "]"}]}]}], "Input",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellLabel->"In[12]:=",
