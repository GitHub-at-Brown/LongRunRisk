Cell[CellGroupData[{

Cell["ToNum also evaluates parameters numerically:", "MathCaption",
 PageWidth->WindowWidth,
 CellChangeTimes->{{3.9000000000000000*^9, 3.9000000100000000*^9}},
 CellID->100000032,ExpressionUUID->"d1e2f3a4-b5c6-7890-8901-234567890123"],

