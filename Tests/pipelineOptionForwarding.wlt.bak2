(*
 * pipelineOptionForwarding.wlt
 *
 * Tests that buildModels correctly forwards options to downstream functions:
 * - processModels (symbolic options)
 * - createCompiledEq (compile options)
 * - createDatabase (moments options)
 *)

VerificationTest[
	(* Load main package which includes OptionsConfig *)
	With[{packageRoot = DirectoryName[DirectoryName[$TestFileName]]},
		Get[FileNameJoin[{packageRoot, "Kernel", "LongRunRisk.wl"}]];
	];
	True,
	True,
	TestID -> "pipelineOptionForwarding-LoadPackage"
]

(*
 * Test 1: OptionsConfig module loaded correctly
 *)
VerificationTest[
	MemberQ[
		Names["FernandoDuarte`LongRunRisk`Tools`OptionsConfig`*"],
		"defaultConfig"
	],
	True,
	TestID -> "pipelineOptionForwarding-OptionsConfigLoaded"
]

(*
 * Test 2: defaultConfig returns proper structure
 *)
VerificationTest[
	Module[{config},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];
		And[
			AssociationQ[config],
			KeyExistsQ[config, "Symbolic"],
			KeyExistsQ[config, "Compile"],
			KeyExistsQ[config, "Numerical"],
			KeyExistsQ[config, "Build"],
			KeyExistsQ[config, "Moments"]
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-defaultConfigStructure"
]

(*
 * Test 3: normalizeConfig handles legacy flat options
 *)
VerificationTest[
	Module[{config},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`normalizeConfig[
			{"FromScratch" -> True, "PdEquations" -> "AB"}
		];
		And[
			AssociationQ[config],
			config["Build"]["FromScratch"] === True,
			config["Symbolic"]["PdEquations"] === "AB"
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-normalizeLegacyOptions"
]

(*
 * Test 4: normalizeConfig preserves already-normalized config
 *)
VerificationTest[
	Module[{config1, config2},
		config1 = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];
		config1["Build"]["FromScratch"] = True;

		config2 = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`normalizeConfig[config1];

		And[
			AssociationQ[config2],
			config2["Build"]["FromScratch"] === True
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-normalizePreservesConfig"
]

(*
 * Test 5: splitConfig extracts Symbolic options
 *)
VerificationTest[
	Module[{config, symbolicOpts},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];
		config["Symbolic"]["PdEquations"] = "AB";

		symbolicOpts = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`splitConfig[
			config,
			"Symbolic"
		];

		(* Should be a Sequence of Rules *)
		MatchQ[symbolicOpts, (_Rule | _RuleDelayed) ..] ||
		MatchQ[Flatten[{symbolicOpts}], {(_Rule | _RuleDelayed) ...}]
	],
	True,
	TestID -> "pipelineOptionForwarding-splitConfigSymbolic"
]

(*
 * Test 6: splitConfig extracts Compile options
 *)
VerificationTest[
	Module[{config, compileOpts},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];

		compileOpts = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`splitConfig[
			config,
			"Compile"
		];

		(* Should be a Sequence of Rules *)
		MatchQ[compileOpts, (_Rule | _RuleDelayed) ..] ||
		MatchQ[Flatten[{compileOpts}], {(_Rule | _RuleDelayed) ...}]
	],
	True,
	TestID -> "pipelineOptionForwarding-splitConfigCompile"
]

(*
 * Test 7: splitConfig extracts Moments options
 *)
VerificationTest[
	Module[{config, momentsOpts},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];

		momentsOpts = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`splitConfig[
			config,
			"Moments"
		];

		(* Should be a Sequence of Rules *)
		MatchQ[momentsOpts, (_Rule | _RuleDelayed) ..] ||
		MatchQ[Flatten[{momentsOpts}], {(_Rule | _RuleDelayed) ...}]
	],
	True,
	TestID -> "pipelineOptionForwarding-splitConfigMoments"
]

(*
 * Test 8: isNormalized correctly identifies normalized config
 *)
VerificationTest[
	Module[{config},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];
		FernandoDuarte`LongRunRisk`Tools`OptionsConfig`isNormalized[config]
	],
	True,
	TestID -> "pipelineOptionForwarding-isNormalizedTrue"
]

(*
 * Test 9: isNormalized correctly identifies non-normalized config
 *)
VerificationTest[
	Module[{config},
		config = <|"FromScratch" -> True|>;
		FernandoDuarte`LongRunRisk`Tools`OptionsConfig`isNormalized[config]
	],
	False,
	TestID -> "pipelineOptionForwarding-isNormalizedFalse"
]

(*
 * Test 10: mergeNested preserves nested defaults
 *)
VerificationTest[
	Module[{default, custom, merged},
		default = <|
			"Build" -> <|"FromScratch" -> False, "Models" -> All|>,
			"Symbolic" -> <|"PdEquations" -> "B"|>
		|>;
		custom = <|
			"Build" -> <|"FromScratch" -> True|>
		|>;

		merged = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`Private`mergeNested[{default, custom}];

		And[
			merged["Build"]["FromScratch"] === True,  (* Custom overrides *)
			merged["Build"]["Models"] === All,  (* Default preserved *)
			merged["Symbolic"]["PdEquations"] === "B"  (* Default preserved *)
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-mergeNestedPreservesDefaults"
]

(*
 * Test 11: buildModels accepts legacy flat options
 *)
VerificationTest[
	Module[{result},
		(* This should not fail - backward compatibility *)
		result = Check[
			Head[buildModels],
			$Failed,
			buildModels::optx
		];

		result =!= $Failed
	],
	True,
	TestID -> "pipelineOptionForwarding-buildModelsLegacyCompatibility"
]

(*
 * Test 12: buildModels has correct Options definition
 *)
VerificationTest[
	Module[{opts},
		opts = Options[buildModels];
		And[
			ListQ[opts],
			MemberQ[opts, "FromScratch" -> _],
			MemberQ[opts, "Models" -> _]
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-buildModelsOptions"
]

(*
 * Test 13: Verify buildModels follows Rule #1 (own options only)
 *)
VerificationTest[
	Module[{opts, optNames},
		opts = Options[buildModels];
		optNames = First /@ opts;

		(* Should NOT contain processModels-specific options like SimplifyOptions *)
		(* Should NOT contain createCompiledEq-specific options like CompileMode *)
		(* SHOULD contain buildModels-specific options *)
		And[
			MemberQ[optNames, "FromScratch"],
			MemberQ[optNames, "Models"],
			!MemberQ[optNames, "SimplifyOptions"],  (* processModels option *)
			!MemberQ[optNames, "initialGuess"]  (* updateCoeffs option *)
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-buildModelsFollowsRule1"
]

(*
 * Test 14: validateConfig accepts valid config
 *)
VerificationTest[
	Module[{config, result},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`defaultConfig[];

		result = Quiet[
			FernandoDuarte`LongRunRisk`Tools`OptionsConfig`validateConfig[config],
			FernandoDuarte`LongRunRisk`Tools`OptionsConfig`validateConfig::warn
		];

		result === True
	],
	True,
	TestID -> "pipelineOptionForwarding-validateConfigValid"
]

(*
 * Test 15: Legacy option mapping for common options
 *)
VerificationTest[
	Module[{config},
		config = FernandoDuarte`LongRunRisk`Tools`OptionsConfig`normalizeConfig[
			{
				"PdEquations" -> "AB",
				"Compiler" -> "CCompiler",
				"MaxMaturity" -> 24,
				"maxMomentsLagsToCreate" -> 12
			}
		];

		And[
			config["Symbolic"]["PdEquations"] === "AB",
			config["Compile"]["Compiler"] === "CCompiler",
			config["Numerical"]["MaxMaturity"] === 24,
			config["Moments"]["maxMomentsLagsToCreate"] === 12
		]
	],
	True,
	TestID -> "pipelineOptionForwarding-legacyOptionMapping"
]
