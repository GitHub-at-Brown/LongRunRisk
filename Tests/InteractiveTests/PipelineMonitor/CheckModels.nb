Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Setup", ":", " ", 
    RowBox[{"Load", " ", 
     RowBox[{"PipelineMonitor", ".", "wl"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "start", ",", " ", "d", ",", " ", "pacletRoot", ",", " ", "pacletFile",
         ",", " ", "pacletObj"}], "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Robust", " ", "paclet", " ", "root", " ", 
         RowBox[{"detection", ":", " ", "$InputFileName"}]}], " ", "->", " ", 
        
        RowBox[{"FindFile", " ", "->", " ", 
         RowBox[{"PacletObject", " ", "->", " ", "Directory"}]}]}], " ", 
       "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"start", " ", "=", " ", 
        RowBox[{"Which", "[", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Primary", ":", " ", 
           RowBox[{
           "use", " ", "$InputFileName", " ", "if", " ", "available"}]}], " ",
           "*)"}], "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
           RowBox[{"$InputFileName", " ", "=!=", " ", "\"\<\>\""}]}], ",", 
          "\n", "      ", 
          RowBox[{"DirectoryName", "[", "$InputFileName", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Fallback", ":", " ", 
            RowBox[{"find", " ", "paclet", " ", "via", " ", "FindFile"}]}], 
           " ", "*)"}], "\n", "    ", 
          RowBox[{"StringQ", "[", 
           RowBox[{"pacletFile", " ", "=", " ", 
            RowBox[{
            "FindFile", 
             "[", "\"\<FernandoDuarte`LongRunRisk`Model`Catalog`\>\"", 
             "]"}]}], "]"}], ",", "\n", "      ", 
          RowBox[{"DirectoryName", "[", 
           RowBox[{"pacletFile", ",", " ", "3"}], "]"}], ",", "  ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Kernel", "/", "Model"}], "/", 
             RowBox[{"Catalog", ".", "wl"}]}], " ", "->", " ", 
            RowBox[{"paclet", " ", "root"}]}], " ", "*)"}], "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Fallback", ":", " ", 
            RowBox[{"find", " ", "via", " ", "PacletObject", " ", 
             RowBox[{"(", 
              RowBox[{
              "works", " ", "when", " ", "loaded", " ", "via", " ", 
               "PacletDirectoryLoad"}], ")"}]}]}], " ", "*)"}], "\n", "    ", 
          
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"pacletObj", " ", "=", " ", 
              RowBox[{
              "PacletObject", "[", "\"\<FernandoDuarte/LongRunRisk\>\"", 
               "]"}]}], ")"}], " ", "=!=", " ", "$Failed"}], " ", "&&", " ", 
           RowBox[{"pacletObj", " ", "=!=", " ", "None"}]}], ",", "\n", 
          "      ", 
          RowBox[{"pacletObj", "[", "\"\<Location\>\"", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Last", " ", 
            RowBox[{"resort", ":", " ", 
             RowBox[{"try", " ", "current", " ", "directory"}]}]}], " ", 
           "*)"}], "\n", "    ", "True", ",", "\n", "      ", 
          RowBox[{"Directory", "[", "]"}]}], "\n", "  ", "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"d", " ", "=", " ", "start"}], ";", "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringQ", "[", "d", "]"}], " ", "&&", " ", 
          RowBox[{"d", " ", "=!=", " ", "\"\<\>\""}], " ", "&&", " ", 
          RowBox[{"!", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "\"\<PacletInfo.wl\>\""}], "}"}], 
             "]"}]}]}], " ", "&&", " ", 
          RowBox[{"d", " ", "=!=", " ", 
           RowBox[{"DirectoryName", "[", "d", "]"}]}]}], ",", "\n", "    ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"DirectoryName", "[", "d", "]"}]}]}], "\n", "  ", "]"}], ";",
        "\n", "  ", 
       RowBox[{"pacletRoot", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"StringQ", "[", "d", "]"}], " ", "&&", " ", 
           RowBox[{"d", " ", "=!=", " ", "\"\<\>\""}], " ", "&&", " ", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"FileNameJoin", "[", 
