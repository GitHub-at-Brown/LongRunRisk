         RowBox[{"SetDirectory", "[", "pacletRoot", "]"}]}], "]"}], ";", "\n",
        "  ", 
       RowBox[{"Off", "[", 
        RowBox[{"General", "::", "shdw"}], "]"}], ";", "\n", "  ", 
