        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "pacletRoot", ",", " ", "\"\<Kernel\>\"", ",", " ", "\"\<Tools\>\"",
            ",", " ", "\"\<PipelineMonitor.wl\>\""}], "}"}], "]"}], "]"}], ";",
        "\n", "  ", 
       RowBox[{"On", "[", 
        RowBox[{"General", "::", "shdw"}], "]"}], ";"}]}], "\n", "]"}], ";"}],
    "\n", "\n", 
