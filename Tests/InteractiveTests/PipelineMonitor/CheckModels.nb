              RowBox[{"d", ",", " ", "\"\<PacletInfo.wl\>\""}], "}"}], 
             "]"}]}]}], ",", " ", "d", ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
