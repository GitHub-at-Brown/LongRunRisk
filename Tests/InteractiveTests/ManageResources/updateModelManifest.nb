Notebook[{
Cell["updateModelManifest Tests", "Title",ExpressionUUID->"5b0f71a6-84d5-4b63-94ed-a0277edf3b9a"],

Cell["\<\
Interactive tests for ManageResources updateModelManifest functionality\
\>", "Subtitle",ExpressionUUID->"f517213a-7bad-4fcd-a379-e4606859956b"],

Cell["Setup", "Section",ExpressionUUID->"a30f2ab1-4161-47c4-a531-16d330274af6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Setup", ":", " ", 
    RowBox[{"Load", " ", 
     RowBox[{"ManageResources", ".", "wl"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "start", ",", " ", "d", ",", " ", "pacletRoot", ",", " ", 
        "pacletFile"}], "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Robust", " ", "paclet", " ", "root", " ", 
         RowBox[{"detection", ":", " ", "$InputFileName"}]}], " ", "->", " ", 
        
        RowBox[{"FindFile", " ", "->", " ", "Directory"}]}], " ", "*)"}], 
      "\n", "  ", 
      RowBox[{
       RowBox[{"start", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
           RowBox[{"$InputFileName", " ", "=!=", " ", "\"\<\>\""}]}], ",", 
          "\n", "    ", 
          RowBox[{"DirectoryName", "[", "$InputFileName", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Fallback", ":", " ", 
            RowBox[{"find", " ", "paclet", " ", "via", " ", "FindFile"}]}], 
           " ", "*)"}], "\n", "    ", 
          RowBox[{
           RowBox[{"pacletFile", " ", "=", " ", 
            RowBox[{
            "FindFile", 
             "[", "\"\<FernandoDuarte`LongRunRisk`Model`Catalog`\>\"", 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"StringQ", "[", "pacletFile", "]"}], ",", "\n", "      ", 
             RowBox[{"DirectoryName", "[", 
              RowBox[{"pacletFile", ",", " ", "3"}], "]"}], ",", "  ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Kernel", "/", "Model"}], "/", 
                RowBox[{"Catalog", ".", "wl"}]}], " ", "->", " ", 
               RowBox[{"paclet", " ", "root"}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{"Directory", "[", "]"}]}], "\n", "    ", "]"}]}]}], "\n",
          "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"d", " ", "=", " ", "start"}], ";", "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", " ", 
           RowBox[{"FileExistsQ", "@", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "\"\<PacletInfo.wl\>\""}], "}"}], 
             "]"}]}]}], " ", "&&", " ", 
          RowBox[{"d", " ", "=!=", " ", 
           RowBox[{"DirectoryName", "[", "d", "]"}]}]}], ",", "\n", "    ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"DirectoryName", "[", "d", "]"}]}]}], "]"}], ";", "\n", 
       "  ", 
       RowBox[{"pacletRoot", " ", "=", " ", "d"}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "FindFile", "[", "\"\<FernandoDuarte`LongRunRisk`Model`Catalog`\>\"",
            "]"}], " ", "===", " ", "$Failed"}], ",", "\n", "    ", 
         RowBox[{
          RowBox[{
          "BeginPackage", 
           "[", "\"\<FernandoDuarte`LongRunRisk`Model`Catalog`\>\"", "]"}], ";",
           " ", 
          RowBox[{"EndPackage", "[", "]"}], ";"}]}], "\n", "  ", "]"}], ";", 
       "\n", "  ", 
       RowBox[{"Off", "[", 
        RowBox[{"General", "::", "shdw"}], "]"}], ";", "\n", "  ", 
       RowBox[{"Get", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "pacletRoot", ",", " ", "\"\<Kernel\>\"", ",", " ", "\"\<Tools\>\"",
            ",", " ", "\"\<ManageResources.wl\>\""}], "}"}], "]"}], "]"}], ";",
        "\n", "  ", 
       RowBox[{"On", "[", 
        RowBox[{"General", "::", "shdw"}], "]"}], ";"}]}], "\n", "]"}], ";"}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Extract", " ", "private", " ", "symbols", " ", "for", " ", "testing"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"$getHash", " ", "=", " ", 
     RowBox[{
     "ToExpression", 
      "[", "\"\<FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCanonicalHash\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$canonicalize", " ", "=", " ", 
     RowBox[{
     "ToExpression", 
      "[", "\"\<FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
canonicalize\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$findPacletRoot", " ", "=", " ", 
     RowBox[{
     "ToExpression", 
      "[", "\"\<FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$getVersion", " ", "=", " ", 
     RowBox[{
     "ToExpression", 
      "[", "\"\<FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getVersion\>\"", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"$timeLimit", " ", "=", " ", "5"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Helper", " ", "for", " ", "creating", " ", "temp", " ", "directories"}],
      " ", "-", " ", 
     RowBox[{
     "uses", " ", "$TemporaryDirectory", " ", "as", " ", "reliable", " ", 
      "fallback"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"$makeTempDir", "[", "]"}], " ", ":=", " ", 
     RowBox[{"CreateDirectory", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"$TemporaryDirectory", ",", " ", 
         RowBox[{"\"\<lrr-test-\>\"", " ", "<>", " ", 
          RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], "]"}]}], ";"}], 
   "\n", "\n"}]}]], "Input",ExpressionUUID->"f16ed69d-48de-4c9a-a1b0-\
f2202834d105"],

