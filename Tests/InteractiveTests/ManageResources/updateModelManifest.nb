Cell["Hash Consistency with Key Permutation Test", "Section",
 CellChangeTimes->{
  3.974775141221784*^9},ExpressionUUID->"fe371bce-576f-4abf-ab7c-\
1f33a1704aed"],

Cell[BoxData[
 RowBox[{"VerificationTest", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"catalog1", ",", " ", "catalog2"}], "}"}], ",", "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Same", " ", "content"}], ",", " ", 
       RowBox[{
       "different", " ", "key", " ", "order", " ", "at", " ", "multiple", " ",
         "levels"}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{
      RowBox[{"catalog1", " ", "=", " ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<params\>\"", " ", "->", " ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<gamma\>\"", " ", "->", " ", "2"}], ",", " ", 
               RowBox[{"\"\<beta\>\"", " ", "->", " ", "1"}]}], "|>"}]}], ",",
             " ", 
            RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<B\>\""}]}], "|>"}]}],
          ",", "\n", "      ", 
         RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<A\>\""}], ",", " ", 
            RowBox[{"\"\<params\>\"", " ", "->", " ", 
             RowBox[{"<|", 
              RowBox[{"\"\<alpha\>\"", " ", "->", " ", "0"}], "|>"}]}]}], 
           "|>"}]}]}], "\n", "    ", "|>"}]}], ";", "\n", "    ", 
      RowBox[{"catalog2", " ", "=", " ", 
       RowBox[{"<|", "\n", "      ", 
        RowBox[{
         RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<params\>\"", " ", "->", " ", 
             RowBox[{"<|", 
              RowBox[{"\"\<alpha\>\"", " ", "->", " ", "0"}], "|>"}]}], ",", 
            " ", 
            RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<A\>\""}]}], "|>"}]}],
          ",", "\n", "      ", 
         RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<B\>\""}], ",", " ", 
            RowBox[{"\"\<params\>\"", " ", "->", " ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<beta\>\"", " ", "->", " ", "1"}], ",", " ", 
               RowBox[{"\"\<gamma\>\"", " ", "->", " ", "2"}]}], "|>"}]}]}], 
           "|>"}]}]}], "\n", "    ", "|>"}]}], ";", "\n", "    ", 
      RowBox[{
       RowBox[{"$getHash", "[", "catalog1", "]"}], " ", "===", " ", 
       RowBox[{"$getHash", "[", "catalog2", "]"}]}]}]}], "\n", "  ", "]"}], ",",
    "\n", "  ", "True", ",", "\n", "  ", 
   RowBox[{
   "TestID", " ", "->", 
    " ", "\"\<hash-complex-permutation-invariant@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:155,1-170,2\>\""}]}], "\n", 
  "]"}]], "Input",
