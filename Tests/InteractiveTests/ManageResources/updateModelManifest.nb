             RowBox[{"Map", "[", 
              RowBox[{"$getHash", ",", " ", "catalogOverride"}], "]"}]}]}], 
           "\n", "      ", "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"versionOK", " ", "=", " ", 
            RowBox[{"StringQ", "[", 
             RowBox[{"baseResult", "[", "\"\<PacletVersion\>\"", "]"}], 
             "]"}]}], ";", "\n", "      ", 
