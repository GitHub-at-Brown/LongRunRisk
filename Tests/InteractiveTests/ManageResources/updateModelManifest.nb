Cell[CellGroupData[{

Cell["updateModelManifest Success Path Test", "Section",
 CellChangeTimes->{
  3.974775158897409*^9},ExpressionUUID->"c9b1c9b9-3076-4441-b8f4-\
7255e6275992"],

Cell[BoxData[
 RowBox[{"VerificationTest", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Module", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "tmp", ",", " ", "manifestFile", ",", " ", "catalogOverride", ",", " ", 
       "result", ",", " ", "fileData", ",", " ", "dropDate", ",", " ", 
       "dateOK", ",", " ", "versionOK", ",", " ", "hashesOK"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"tmp", " ", "=", " ", 
       RowBox[{"$makeTempDir", "[", "]"}]}], ";", "\n", "    ", 
      RowBox[{"manifestFile", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "tmp", ",", " ", "\"\<Resources\>\"", ",", 
          " ", "\"\<ModelManifest.wl\>\""}], "}"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"catalogOverride", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], "|>"}]}], ",", " ", 
         RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{"\"\<b\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2"}], "}"}]}], "|>"}]}]}], "|>"}]}], ";",
       "\n", "    ", 
      RowBox[{"dropDate", " ", "=", " ", 
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", "\"\<Date\>\"", "}"}]}], "]"}], " ", "&"}]}], ";", 
      "\n", "    ", 
      RowBox[{"Block", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", "\n", "        ", 
         RowBox[{
         "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", ",", "\n", "        ", 
          "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels"}], "\n", "      ", "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{
          "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", "[", "]"}], " ", ":=", " ", "tmp"}], ";", "\n", "      ", 
         RowBox[{
          RowBox[{
          "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels", "[", "]"}], " ", ":=", " ", "catalogOverride"}], ";", "\n",
          "      ", 
         RowBox[{"result", " ", "=", " ", 
          RowBox[{"updateModelManifest", "[", "]"}]}], ";", "\n", "      ", 
         RowBox[{"fileData", " ", "=", " ", 
          RowBox[{"Get", "[", "manifestFile", "]"}]}], ";"}]}], "\n", "    ", 
       "]"}], ";", "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"DirectoryQ", "[", "tmp", "]"}], ",", " ", 
        RowBox[{"DeleteDirectory", "[", 
         RowBox[{"tmp", ",", " ", 
          RowBox[{"DeleteContents", " ", "->", " ", "True"}]}], "]"}]}], 
       "]"}], ";", "\n", "    ", 
      RowBox[{"dateOK", " ", "=", " ", 
       RowBox[{"StringQ", "[", 
        RowBox[{"result", "[", "\"\<Date\>\"", "]"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"With", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"{", "\n", "        ", 
         RowBox[{
          RowBox[{"baseResult", " ", "=", " ", 
           RowBox[{"dropDate", "[", "result", "]"}]}], ",", "\n", "        ", 
          
          RowBox[{"baseFile", " ", "=", " ", 
           RowBox[{"dropDate", "[", "fileData", "]"}]}], ",", "\n", 
          "        ", 
          RowBox[{"expectedCatalogHash", " ", "=", " ", 
           RowBox[{"$getHash", "[", "catalogOverride", "]"}]}], ",", "\n", 
          "        ", 
          RowBox[{"expectedModelHashes", " ", "=", " ", 
           RowBox[{"Map", "[", 
            RowBox[{"$getHash", ",", " ", "catalogOverride"}], "]"}]}]}], 
         "\n", "      ", "}"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"versionOK", " ", "=", " ", 
          RowBox[{"StringQ", "[", 
           RowBox[{"baseResult", "[", "\"\<PacletVersion\>\"", "]"}], "]"}]}],
          ";", "\n", "      ", 
         RowBox[{"hashesOK", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"baseResult", "[", "\"\<CatalogHash\>\"", "]"}], " ", "===",
             " ", "expectedCatalogHash"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"baseResult", "[", "\"\<Models\>\"", "]"}], " ", "===", 
            " ", "expectedModelHashes"}]}]}], ";", "\n", "      ", 
         RowBox[{
          RowBox[{"baseResult", " ", "===", " ", "baseFile"}], " ", "&&", " ",
           "versionOK", " ", "&&", " ", "hashesOK", " ", "&&", " ", 
          "dateOK"}]}]}], "\n", "    ", "]"}]}]}], "\n", "  ", "]"}], ",", 
   "\n", "  ", "True", ",", "\n", "  ", 
   RowBox[{"TimeConstraint", " ", "->", " ", "$timeLimit"}], ",", "\n", "  ", 
   
   RowBox[{
   "TestID", " ", "->", 
    " ", "\"\<writes-manifest-with-expected-content@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:115,1-149,2\>\""}]}], "\n", 
  "]"}]], "Input",
 CellChangeTimes->{{3.974775149995119*^9, 
  3.974775157306974*^9}},ExpressionUUID->"3db88e65-c463-4dd7-9f44-\
41b2e0b751c1"]
}, Open  ]],

