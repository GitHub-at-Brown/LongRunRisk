         RowBox[{
         "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", "[", "]"}], " ", ":=", " ", "$Failed"}], ";", "\n", "    ", 
        RowBox[{"updateModelManifest", "[", "]"}]}]}], "\n", "  ", "]"}], ",",
      "\n", "  ", "$Failed", ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"updateModelManifest", "::", "noroot"}], "}"}], ",", "\n", "  ", 
     RowBox[{"TimeConstraint", " ", "->", " ", "$timeLimit"}], ",", "\n", 
     "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<fails-when-root-not-found@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:76,1-86,2\>\""}]}], "\n", "]"}], "\n",
    "\n", 
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tmp", ",", " ", "manifestFile", ",", " ", "result", ",", " ", 
         "fileExists"}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"tmp", " ", "=", " ", 
         RowBox[{"$makeTempDir", "[", "]"}]}], ";", "\n", "    ", 
        RowBox[{"manifestFile", " ", "=", " ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "tmp", ",", " ", "\"\<Resources\>\"", ",", 
            " ", "\"\<ModelManifest.wl\>\""}], "}"}], "]"}]}], ";", "\n", 
        "    ", 
        RowBox[{"Block", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
           "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", ",", "\n", "        ", 
            "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels"}], "\n", "      ", "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
