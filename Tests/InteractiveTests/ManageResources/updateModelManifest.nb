   "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Module", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "tmp", ",", " ", "manifestFile", ",", " ", "catalogOverride", ",", 
         " ", "result", ",", " ", "fileData", ",", " ", "dropDate", ",", " ", 
         "dateOK", ",", " ", "versionOK", ",", " ", "hashesOK"}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{"tmp", " ", "=", " ", 
         RowBox[{"$makeTempDir", "[", "]"}]}], ";", "\n", "    ", 
        RowBox[{"manifestFile", " ", "=", " ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "tmp", ",", " ", "\"\<Resources\>\"", ",", 
            " ", "\"\<ModelManifest.wl\>\""}], "}"}], "]"}]}], ";", "\n", 
        "    ", 
        RowBox[{"catalogOverride", " ", "=", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
            RowBox[{"<|", 
             RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], "|>"}]}], ",", " ", 
           RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
            RowBox[{"<|", 
             RowBox[{"\"\<b\>\"", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}]}], "|>"}]}]}], "|>"}]}], ";",
         "\n", "    ", 
        RowBox[{"dropDate", " ", "=", " ", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", "\"\<Date\>\"", "}"}]}], "]"}], " ", "&"}]}], ";", 
        "\n", "    ", 
        RowBox[{"Block", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
           "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", ",", "\n", "        ", 
            "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels"}], "\n", "      ", "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
            "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot", "[", "]"}], " ", ":=", " ", "tmp"}], ";", "\n", "      ", 
           RowBox[{
            RowBox[{
            "FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels", "[", "]"}], " ", ":=", " ", "catalogOverride"}], ";", "\n",
            "      ", 
           RowBox[{"result", " ", "=", " ", 
            RowBox[{"updateModelManifest", "[", "]"}]}], ";", "\n", "      ", 
           
           RowBox[{"fileData", " ", "=", " ", 
            RowBox[{"Get", "[", "manifestFile", "]"}]}], ";"}]}], "\n", 
         "    ", "]"}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"DirectoryQ", "[", "tmp", "]"}], ",", " ", 
          RowBox[{"DeleteDirectory", "[", 
           RowBox[{"tmp", ",", " ", 
            RowBox[{"DeleteContents", " ", "->", " ", "True"}]}], "]"}]}], 
         "]"}], ";", "\n", "    ", 
        RowBox[{"dateOK", " ", "=", " ", 
         RowBox[{"StringQ", "[", 
          RowBox[{"result", "[", "\"\<Date\>\"", "]"}], "]"}]}], ";", "\n", 
        "    ", 
        RowBox[{"With", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{"baseResult", " ", "=", " ", 
             RowBox[{"dropDate", "[", "result", "]"}]}], ",", "\n", 
            "        ", 
            RowBox[{"baseFile", " ", "=", " ", 
