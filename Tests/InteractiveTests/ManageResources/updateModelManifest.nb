 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Setup", ":", " ", 
    RowBox[{"Load", " ", 
     RowBox[{"ManageResources", ".", "wl"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
