Cell["\<\
*)

VerificationTest[
  Block[
    {FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`findPacletRoot},\

    FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`findPacletRoot[] \
: $Failed;
    updateModelManifest[]
  ],
  $Failed,
  {updateModelManifest::noroot},
  TimeConstraint -> $timeLimit,
  TestID -> \
\"fails-when-root-not-found@@Tests/InteractiveTests/ManageResources/\
updateModelManifest.wlt:76,1-86,2\"
]

VerificationTest[
  Module[{tmp, manifestFile, result, fileExists},
    tmp  $makeTempDir[];
    manifestFile  FileNameJoin[{tmp, \"Resources\", \"ModelManifest.wl\"}];
    Block[
      {
        FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
findPacletRoot,
        FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels
      },
      FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`findPacletRoot[\
] : tmp;
      FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getCatalogModels[] : 42;  (* Not an association\
\>", "Section",ExpressionUUID->"7c56b1c2-e2db-431a-a541-ca021e3e4455"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
