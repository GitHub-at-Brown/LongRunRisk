Cell["\<\
*)

VerificationTest[
  $getHash[<|\"b\" -> 1, \"a\" -> 2|>]  $getHash[<|\"a\" -> 2, \"b\" -> 1|>],
  True,
  TestID -> \
\"hash-key-order-invariant@@Tests/InteractiveTests/ManageResources/\
updateModelManifest.wlt:40,1-44,2\"
]

VerificationTest[
  $getHash[<|\"x\" -> <|\"b\" -> 1, \"a\" -> 2|>|>]  $getHash[<|\"x\" -> \
<|\"a\" -> 2, \"b\" -> 1|>|>],
  True,
  TestID -> \
\"hash-nested-key-order-invariant@@Tests/InteractiveTests/ManageResources/\
updateModelManifest.wlt:46,1-50,2\"
]

VerificationTest[
  $getHash[<|\"z\" -> {<|\"b\" -> 1|>, <|\"a\" -> 2|>}|>]  $getHash[<|\"z\" \
-> {<|\"b\" -> 1|>, <|\"a\" -> 2|>}|>],
  True,
  TestID -> \
\"hash-list-of-associations@@Tests/InteractiveTests/ManageResources/\
updateModelManifest.wlt:52,1-56,2\"
]

VerificationTest[
  (* Different content should produce different hashes *)
  $getHash[<|\"a\" -> 1|>] ! $getHash[<|\"a\" -> 2|>],
  True,
  TestID -> \
\"hash-different-values-differ@@Tests/InteractiveTests/ManageResources/\
updateModelManifest.wlt:58,1-63,2\"
]

VerificationTest[
  (* Canonicalize should sort keys recursively\
\>", "Section",ExpressionUUID->"21a8f241-b396-4844-b570-eaa3eef73bfa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}]}], "|>"}], "]"}], " ", "===",
       " ", 
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], ",", " ", 
         RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}]}], "|>"}], "]"}]}], ",", 
     "\n", "  ", "True", ",", "\n", "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<hash-key-order-invariant@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:40,1-44,2\>\""}]}], "\n", "]"}], "\n",
    "\n", 
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<x\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}]}], "|>"}]}], "|>"}], 
       "]"}], " ", "===", " ", 
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<x\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], ",", " ", 
           RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}]}], "|>"}]}], "|>"}], 
       "]"}]}], ",", "\n", "  ", "True", ",", "\n", "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<hash-nested-key-order-invariant@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:46,1-50,2\>\""}]}], "\n", "]"}], "\n",
    "\n", 
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<z\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], "|>"}]}], "}"}]}], 
        "|>"}], "]"}], " ", "===", " ", 
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<z\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{"\"\<b\>\"", " ", "->", " ", "1"}], "|>"}], ",", " ", 
           RowBox[{"<|", 
            RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], "|>"}]}], "}"}]}], 
        "|>"}], "]"}]}], ",", "\n", "  ", "True", ",", "\n", "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<hash-list-of-associations@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:52,1-56,2\>\""}]}], "\n", "]"}], "\n",
    "\n", 
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Different", " ", "content", " ", "should", " ", "produce", " ", 
      "different", " ", "hashes"}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], "|>"}], "]"}], " ", "=!=",
       " ", 
      RowBox[{"$getHash", "[", 
       RowBox[{"<|", 
        RowBox[{"\"\<a\>\"", " ", "->", " ", "2"}], "|>"}], "]"}]}], ",", 
     "\n", "  ", "True", ",", "\n", "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<hash-different-values-differ@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:58,1-63,2\>\""}]}], "\n", "]"}], "\n",
    "\n", 
   RowBox[{"VerificationTest", "[", "\n", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Canonicalize", " ", "should", " ", "sort", " ", "keys", " ", 
      "recursively"}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{"$canonicalize", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<b\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<d\>\"", " ", "->", " ", "1"}], ",", " ", 
           RowBox[{"\"\<c\>\"", " ", "->", " ", "2"}]}], "|>"}]}], ",", " ", 
        RowBox[{"\"\<a\>\"", " ", "->", " ", "3"}]}], "|>"}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<a\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<b\>\"", " ", "->", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<c\>\"", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"\"\<d\>\"", " ", "->", " ", "1"}]}], "|>"}]}]}], "|>"}], ",",
      "\n", "  ", 
     RowBox[{
     "TestID", " ", "->", 
      " ", "\"\<canonicalize-sorts-nested-keys@@Tests/InteractiveTests/\
ManageResources/updateModelManifest.wlt:65,1-70,2\>\""}]}], "\n", "]"}], "\n",
    "\n"}]}]], "Input",ExpressionUUID->"98ada5d6-700e-463a-b582-da5c6ee9fffd"],

