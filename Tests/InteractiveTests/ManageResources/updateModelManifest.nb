     RowBox[{
     "ToExpression", 
      "[", "\"\<FernandoDuarte`LongRunRisk`Tools`ManageResources`Private`\
getVersion\>\"", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"$timeLimit", " ", "=", " ", "5"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
