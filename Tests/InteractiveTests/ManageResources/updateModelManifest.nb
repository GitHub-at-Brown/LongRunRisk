VerificationTest[
  Module[{catalog1, catalog2},
    (* Same content, different key order at multiple levels\
\>", "Section",ExpressionUUID->"545767da-fae6-4fa3-8c90-5376d59f63c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"VerificationTest", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"catalog1", ",", " ", "catalog2"}], "}"}], ",", "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Same", " ", "content"}], ",", " ", 
        RowBox[{
        "different", " ", "key", " ", "order", " ", "at", " ", "multiple", " ",
          "levels"}]}], " ", "*)"}], "\n", "    ", 
      RowBox[{
       RowBox[{"catalog1", " ", "=", " ", 
        RowBox[{"<|", "\n", "      ", 
         RowBox[{
          RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<params\>\"", " ", "->", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<gamma\>\"", " ", "->", " ", "2"}], ",", " ", 
                RowBox[{"\"\<beta\>\"", " ", "->", " ", "1"}]}], "|>"}]}], ",",
              " ", 
             RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<B\>\""}]}], 
            "|>"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<A\>\""}], ",", " ", 
             
             RowBox[{"\"\<params\>\"", " ", "->", " ", 
              RowBox[{"<|", 
               RowBox[{"\"\<alpha\>\"", " ", "->", " ", "0"}], "|>"}]}]}], 
            "|>"}]}]}], "\n", "    ", "|>"}]}], ";", "\n", "    ", 
       RowBox[{"catalog2", " ", "=", " ", 
        RowBox[{"<|", "\n", "      ", 
         RowBox[{
          RowBox[{"\"\<ModelA\>\"", " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<params\>\"", " ", "->", " ", 
              RowBox[{"<|", 
               RowBox[{"\"\<alpha\>\"", " ", "->", " ", "0"}], "|>"}]}], ",", 
             " ", 
             RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<A\>\""}]}], 
            "|>"}]}], ",", "\n", "      ", 
          RowBox[{"\"\<ModelB\>\"", " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<name\>\"", " ", "->", " ", "\"\<B\>\""}], ",", " ", 
             
             RowBox[{"\"\<params\>\"", " ", "->", " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<beta\>\"", " ", "->", " ", "1"}], ",", " ", 
                RowBox[{"\"\<gamma\>\"", " ", "->", " ", "2"}]}], "|>"}]}]}], 
            "|>"}]}]}], "\n", "    ", "|>"}]}], ";", "\n", "    ", 
       RowBox[{
