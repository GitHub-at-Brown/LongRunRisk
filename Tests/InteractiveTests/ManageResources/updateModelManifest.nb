     RowBox[{"CreateDirectory", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"$TemporaryDirectory", ",", " ", 
         RowBox[{"\"\<lrr-test-\>\"", " ", "<>", " ", 
          RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
