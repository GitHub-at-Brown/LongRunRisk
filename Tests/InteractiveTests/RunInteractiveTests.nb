             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", "8"}], ",", "8"}], "]"}], ",", "1"}], "]"}], ",", 
           
           RowBox[{"{", "2", "}"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"testMomentsOneStockN", "=", 
       RowBox[{
        RowBox[{"Activate", "[", 
         RowBox[{"testMomentsOneStock", "/.", 
