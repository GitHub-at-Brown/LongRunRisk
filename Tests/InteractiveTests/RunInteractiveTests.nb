 RowBox[{
  RowBox[{"noMissingTest", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"testNumber", "=", "\n", 
       RowBox[{"Sort", "@", 
