                RowBox[{"Length", "[", "tuples3q", "]"}], ",", "ntest"}], 
               "]"}], "}"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"testMoments3q", "=", 
          RowBox[{"Table", "[", 
